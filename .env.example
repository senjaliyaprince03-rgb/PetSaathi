# ==============================================================================
# PETSAATHI — ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# Dog-Walking & Pet-Care Platform for Indian Residential Societies
# Copy this file to .env.local (dev) or configure in your production secrets manager.
# NEVER COMMIT ACTUAL CREDENTIALS OR API KEYS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime mode: development | test | production
NODE_ENV=development

# Canonical base URL of the frontend application
# In production, must be an HTTPS URL (e.g., https://petsaathi.in)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server port (default 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE (MONGODB ATLAS & PRISMA ORM)
# ------------------------------------------------------------------------------
# Direct MongoDB connection string with credentials (TLS enabled)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://app_user:CHANGE_ME_STRONG_PASSWORD@cluster0.petsaathi.mongodb.net/petsaathi_prod?retryWrites=true&w=majority"

# Optional direct MONGODB_URI for native MongoClient operations (if different from DATABASE_URL)
MONGODB_URI="mongodb+srv://app_user:CHANGE_ME_STRONG_PASSWORD@cluster0.petsaathi.mongodb.net/petsaathi_prod?retryWrites=true&w=majority"
MONGODB_DATABASE=petsaathi_prod

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (NEXTAUTH / JWT)
# ------------------------------------------------------------------------------
# Cryptographically secure random secret (min 32 chars) for JWT encrypt/decrypt
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_MINIMUM_32_CHARS_CRYPTO_RANDOM_SECRET"
NEXTAUTH_SECRET="CHANGE_ME_MINIMUM_32_CHARS_CRYPTO_RANDOM_SECRET"

# Session expiration duration in days (default 30, min 1, max 90)
AUTH_SESSION_DAYS=30

# DO NOT USE IN PRODUCTION. Fixed 6-digit OTP for local dev/testing only.
# Must be omitted in production — validated by src/lib/env.ts
# AUTH_DEV_FIXED_OTP=123456

# HMAC secret for signed upload URLs (min 32 chars)
UPLOAD_SIGNING_SECRET="CHANGE_ME_MINIMUM_32_CHARS_SIGNING_SECRET"

# ------------------------------------------------------------------------------
# 4. PAYMENTS & GATEWAY (RAZORPAY)
# ------------------------------------------------------------------------------
# Razorpay Key ID (public key for frontend checkout popup)
# Test mode prefix: rzp_test_* | Live production prefix: rzp_live_*
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_CHANGE_ME_KEY_ID

# Razorpay Key Secret (private server-side API secret)
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET

# Razorpay Webhook Secret (used to verify X-Razorpay-Signature on incoming webhooks)
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 5. NVIDIA AI ROUTER (KNOWLEDGE BASE & CHATBOT PIPELINE)
# ------------------------------------------------------------------------------
# NVIDIA API Key (generated from build.nvidia.com)
NVIDIA_API_KEY="nvapi-CHANGE_ME_YOUR_NVIDIA_API_KEY"

# NVIDIA API Base URL (OpenAI-compatible inference endpoint)
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Maximum retry attempts on retryable rate-limits or network blips
NVIDIA_MAX_RETRIES=2

# Model discovery cache TTL in milliseconds (default 1 hour)
NVIDIA_MODEL_CACHE_TTL_MS=3600000

# ------------------------------------------------------------------------------
# 6. COMMUNICATION & NOTIFICATIONS (WHATSAPP, SMS, EMAIL)
# ------------------------------------------------------------------------------
# Resend Email API Key & Sender Address
RESEND_API_KEY=re_CHANGE_ME_API_KEY
RESEND_FROM_EMAIL="support@petsaathi.in"
RESEND_REQUEST_TIMEOUT_MS=8000

# Meta WhatsApp Cloud API credentials for automated status updates
WHATSAPP_ACCESS_TOKEN="EAA...CHANGE_ME"
WHATSAPP_PHONE_NUMBER_ID="CHANGE_ME_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="CHANGE_ME_BUSINESS_ID"

# SMS Gateway Webhook URL & HMAC validation secret for OTP delivery
SMS_OTP_WEBHOOK_URL="https://sms-provider.example.com/send"
SMS_OTP_WEBHOOK_SECRET="CHANGE_ME_SMS_HMAC_SECRET"

# ------------------------------------------------------------------------------
# 7. CRON, BACKGROUND JOBS & SCANNER SECURITY
# ------------------------------------------------------------------------------
# Shared bearer token for scheduled maintenance and reconciliation jobs
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="CHANGE_ME_MINIMUM_32_CHARS_CRON_SECRET"

# Callback secret for document verification / malware scanner callbacks
SCANNER_CALLBACK_SECRET="CHANGE_ME_MINIMUM_32_CHARS_SCANNER_SECRET"

# Days to retain detailed GPS telemetry breadcrumbs before aggregation (default 30)
TRACKING_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & ERROR TRACKING (SENTRY)
# ------------------------------------------------------------------------------
# Sentry DSN for backend and edge runtime error tracking
SENTRY_DSN="https://example_key@o000000.ingest.sentry.io/0000000"
NEXT_PUBLIC_SENTRY_DSN="https://example_key@o000000.ingest.sentry.io/0000000"
SENTRY_AUTH_TOKEN="sntrys_CHANGE_ME"
SENTRY_ORG="petsaathi"
SENTRY_PROJECT="petsaathi-app"

# ------------------------------------------------------------------------------
# 9. MAPS & GEO-INTELLIGENCE
# ------------------------------------------------------------------------------
# Provider: mappls | google | openstreetmap | mapbox | disabled
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap
NEXT_PUBLIC_MAPPLS_API_KEY=CHANGE_ME_MAPPLS_KEY
NEXT_PUBLIC_GOOGLE_MAPS_KEY=CHANGE_ME_GOOGLE_KEY

# ------------------------------------------------------------------------------
# 10. SOCIAL MEDIA & ANALYTICS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SOCIAL_X_URL="https://x.com/petsaathi"
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL="https://instagram.com/petsaathi"
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL="https://facebook.com/petsaathi"
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL="https://linkedin.com/company/petsaathi"

# ------------------------------------------------------------------------------
# 11. MOBILE SHELL CONFIGURATION (CAPACITOR ANDROID)
# ------------------------------------------------------------------------------
# Override URL when running Capacitor inside Android Studio emulator or device
# Android emulator loopback: http://10.0.2.2:3000 | Physical device: https://petsaathi.in
CAPACITOR_SERVER_URL="http://10.0.2.2:3000"
