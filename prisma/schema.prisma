enum CreditType {
  SUBSCRIPTION
  PROMOTIONAL
  REFUND
  LOYALTY
  SERVICE_RECOVERY
}

enum CreditAction {
  ISSUED
  CONSUMED
  EXPIRED
  REVERSED
  ADJUSTED
}

model ServiceCredit {
  id           String                     @id @default(uuid()) @db.Uuid
  userId       String                     @map("user_id") @db.Uuid
  type         CreditType
  amountPaise  Int                        @map("amount_paise")
