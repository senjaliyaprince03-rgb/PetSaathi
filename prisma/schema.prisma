// Later-phase records are deliberately private and inert until their server-side
// feature gates and operating policies are approved.
model City {
  id                 String                     @id @default(uuid()) @db.Uuid
  slug               String                     @unique
  name               String
  state              String
  timezone           String                     @default("Asia/Kolkata")
  status             CityLaunchStage            @default(RESEARCH)
  launchCriteria     Json?                      @map("launch_criteria")
  launchedAt         DateTime?                  @map("launched_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  serviceZones       ServiceZone[]
  cityServiceConfigs CityServiceConfiguration[]
  serviceAreas       ServiceArea[]
  partnerLocations   PartnerLocation[]
  cityPages          CityPage[]

  // Phase 13 B2B relations
  organizations Organization[]

  // Phase 14 Scale & Ops
  financialRecords CityFinancialRecord[]
  healthScores     CityHealthScore[]
  cityManagers     CityManager[]
  territories      Territory[]

  @@index([status, name])
  @@map("cities")
}

