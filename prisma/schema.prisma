  @@map("benefit_wallets")
}

model BenefitLedgerEntry {
  id             String           @id @default(uuid()) @db.Uuid
  walletId       String           @map("wallet_id") @db.Uuid
  entryType      BenefitEntryType @map("entry_type")
  amountPaise    Int              @map("amount_paise")
  balanceAfter   Int              @map("balance_after")
  bookingId      String?          @map("booking_id") @db.Uuid
  invoiceId      String?          @map("invoice_id") @db.Uuid
  reference      String?
  idempotencyKey String?          @unique @map("idempotency_key")
  createdAt      DateTime         @default(now()) @map("created_at")

  wallet BenefitWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("benefit_ledger_entries")
}

model PromotionCode {
  id              String   @id @default(uuid()) @db.Uuid
  programmeId     String?  @map("programme_id") @db.Uuid
  code            String   @unique
  discountType    String   @map("discount_type")
  discountValue   Int      @map("discount_value")
  maximumDiscount Int?     @map("maximum_discount")
  minimumOrder    Int?     @map("minimum_order")
  totalUsageLimit Int?     @map("total_usage_limit")
  perMemberLimit  Int?     @default(1) @map("per_member_limit")
  serviceScope    String[] @map("service_scope")
  cityScope       String[] @map("city_scope")
  validFrom       DateTime @map("valid_from")
  validUntil      DateTime @map("valid_until")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  programme PartnerProgramme? @relation(fields: [programmeId], references: [id])

  @@index([programmeId])
  @@map("promotion_codes")
}

model EnterpriseInvoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number")
  organizationId String        @map("organization_id") @db.Uuid
  contractId     String?       @map("contract_id") @db.Uuid
  supplierGstin  String?       @map("supplier_gstin")
  customerGstin  String?       @map("customer_gstin")
  placeOfSupply  String?       @map("place_of_supply")
  billingAddress String?       @map("billing_address")
  serviceAddress String?       @map("service_address")
  sacCode        String?       @map("sac_code")
  taxableValue   Int           @map("taxable_value")
  cgst           Int           @default(0)
  sgst           Int           @default(0)
  igst           Int           @default(0)
  totalAmount    Int           @map("total_amount")
  amountPaid     Int           @default(0) @map("amount_paid")
  currency       String        @default("INR")
  status         InvoiceStatus @default(DRAFT_INVOICE)
  dueDate        DateTime      @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  poReference    String?       @map("po_reference")
  notes          String?
  creditNoteOf   String?       @map("credit_note_of") @db.Uuid
  irnNumber      String?       @map("irn_number")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     B2bContract? @relation(fields: [contractId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@map("enterprise_invoices")
}

// ═══════════════════════════════════════════════════════════════
// Phase 14 — Scale, Funding, & Franchise Operating System
// ═══════════════════════════════════════════════════════════════

model CityFinancialRecord {
  id          String @id @default(uuid()) @db.Uuid
  cityId      String @map("city_id") @db.Uuid
  periodMonth Int    @map("period_month")
  periodYear  Int    @map("period_year")

  // GBV and Revenue
  gbvPaise        BigInt @default(0) @map("gbv_paise")
  netRevenuePaise BigInt @default(0) @map("net_revenue_paise")

  // Margins
  cm1Paise BigInt @default(0) @map("cm1_paise")
  cm2Paise BigInt @default(0) @map("cm2_paise")

  // Customer Acquisition
  blendedCacPaise Int    @default(0) @map("blended_cac_paise")
  marketingSpend  BigInt @default(0) @map("marketing_spend")

  // Activity metrics
  totalBookings   Int @default(0) @map("total_bookings")
  activeCustomers Int @default(0) @map("active_customers")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city City @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@unique([cityId, periodMonth, periodYear])
  @@map("city_financial_records")
}

model CityHealthScore {
  id         String   @id @default(uuid()) @db.Uuid
  cityId     String   @map("city_id") @db.Uuid
  periodDate DateTime @map("period_date") @db.Date

  // Scores (0-100)
  overallScore    Int @map("overall_score")
  safetyScore     Int @map("safety_score")
  supplyScore     Int @map("supply_score")
  demandScore     Int @map("demand_score")
  operationsScore Int @map("operations_score")

  // Hard Gates
  hasUnresolvedSevere Boolean @default(false) @map("has_unresolved_severe")
  cm2Deterioration    Boolean @default(false) @map("cm2_deterioration")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId, periodDate])
  @@map("city_health_scores")
}

model CityManager {
  id         String    @id @default(uuid()) @db.Uuid
  cityId     String    @map("city_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  status     String    @default("ACTIVE") // ACTIVE, INACTIVE
  assignedAt DateTime  @default(now()) @map("assigned_at")
  revokedAt  DateTime? @map("revoked_at")

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([cityId, status])
  @@map("city_managers")
}

// ═══════════════════════════════════════════════════════════════
// Phase 14 Sprint 2 — Trust & Safety Command Center
// ═══════════════════════════════════════════════════════════════

enum SuspensionReason {
  SAFETY_INCIDENT
  QUALITY_VIOLATION
  NO_SHOW
  BACKGROUND_CHECK_FAIL
  FRAUD
  OTHER
}

model ProviderSuspension {
  id          String           @id @default(uuid()) @db.Uuid
  sitterId    String           @map("sitter_id") @db.Uuid
  incidentId  String?          @map("incident_id") @db.Uuid
  reason      SuspensionReason
  description String
  issuedAt    DateTime         @default(now()) @map("issued_at")
  expiresAt   DateTime?        @map("expires_at") // null if permanent
  isAppealed  Boolean          @default(false) @map("is_appealed")
  appealNotes String?          @map("appeal_notes")
  liftedAt    DateTime?        @map("lifted_at")
  liftedBy    String?          @map("lifted_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  sitter       User      @relation("SitterSuspensions", fields: [sitterId], references: [id], onDelete: Cascade)
  incident     Incident? @relation(fields: [incidentId], references: [id])
  liftedByUser User?     @relation("SuspensionLifter", fields: [liftedBy], references: [id])

  @@index([sitterId])
  @@map("provider_suspensions")
}

model SafetyAudit {
  id             String   @id @default(uuid()) @db.Uuid
  sitterId       String   @map("sitter_id") @db.Uuid
  auditorId      String   @map("auditor_id") @db.Uuid
  auditDate      DateTime @map("audit_date")
  score          Int // 0-100
  passed         Boolean
  notes          String?
  actionRequired Boolean  @default(false) @map("action_required")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sitter  User @relation("SitterAudits", fields: [sitterId], references: [id], onDelete: Cascade)
  auditor User @relation("AuditorUsers", fields: [auditorId], references: [id])

  @@index([sitterId])
  @@map("safety_audits")
}

// ═══════════════════════════════════════════════════════════════
// Phase 14 Sprint 3 — Franchise & Operator Controls
// ═══════════════════════════════════════════════════════════════

model OperatingPartner {
  id                String         @id @default(uuid()) @db.Uuid
  legalName         String         @map("legal_name")
  displayName       String         @map("display_name")
  contactPersonId   String         @map("contact_person_id") @db.Uuid
  email             String
  phone             String?
  gstin             String?
  panEncrypted      String?        @map("pan_encrypted")
  status            OperatorStatus @default(PROSPECT_OP)
  onboardedAt       DateTime?      @map("onboarded_at")
  pilotStartedAt    DateTime?      @map("pilot_started_at")
  terminatedAt      DateTime?      @map("terminated_at")
  terminationReason String?        @map("termination_reason")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  contactPerson User        @relation("OperatorContact", fields: [contactPersonId], references: [id])
  territories   Territory[]

  @@index([status])
  @@map("operating_partners")
}

model Territory {
  id                 String        @id @default(uuid()) @db.Uuid
  operatingPartnerId String        @map("operating_partner_id") @db.Uuid
  cityId             String        @map("city_id") @db.Uuid
  serviceZoneId      String?       @map("service_zone_id") @db.Uuid
  territoryType      TerritoryType @default(MANAGED)
  name               String
  isActive           Boolean       @default(true) @map("is_active")
  agreedRevShareBps  Int           @default(0) @map("agreed_rev_share_bps")
  startDate          DateTime      @map("start_date")
  endDate            DateTime?     @map("end_date")
  notes              String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  operatingPartner OperatingPartner @relation(fields: [operatingPartnerId], references: [id], onDelete: Cascade)
  city             City             @relation(fields: [cityId], references: [id])
  serviceZone      ServiceZone?     @relation(fields: [serviceZoneId], references: [id])

  @@unique([operatingPartnerId, cityId, serviceZoneId])
  @@index([cityId])
  @@map("territories")
}

// ═══════════════════════════════════════════════════════════════
// Phase 14 Sprint 4 — Privacy & DPDP Compliance
// ═══════════════════════════════════════════════════════════════

model ContentConsentRecord {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  purpose        ConsentPurpose
  consentVersion String         @map("consent_version")
  grantedAt      DateTime       @default(now()) @map("granted_at")
  expiresAt      DateTime?      @map("expires_at")
  revokedAt      DateTime?      @map("revoked_at")
  revokedReason  String?        @map("revoked_reason")
  ipAddress      String?        @map("ip_address")
  userAgent      String?        @map("user_agent")
  createdAt      DateTime       @default(now()) @map("created_at")

  user User @relation("UserConsents", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("content_consent_records")
}

model DataSubjectRequest {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  requestType   DataRequestType   @map("request_type")
  status        DataRequestStatus @default(PENDING_DSR)
  description   String?
  handledById   String?           @map("handled_by_id") @db.Uuid
  completedAt   DateTime?         @map("completed_at")
  responseNotes String?           @map("response_notes")
  dueDate       DateTime          @map("due_date")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  user      User  @relation("UserDataRequests", fields: [userId], references: [id], onDelete: Cascade)
  handledBy User? @relation("HandledDataRequests", fields: [handledById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("data_subject_requests")
}

model DataRetentionPolicy {
  id            String    @id @default(uuid()) @db.Uuid
  entityType    String    @map("entity_type") // e.g., "User", "Booking", "Incident"
  retentionDays Int       @map("retention_days")
  action        String // ANONYMIZE, DELETE
  isActive      Boolean   @default(true) @map("is_active")
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([entityType])
  @@map("data_retention_policies")
}
