model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  authUserId               String                    @unique @map("auth_user_id") @db.Uuid
  email                    String?                   @unique
  phoneE164                String?                   @unique @map("phone_e164")
  displayName              String                    @map("display_name")
  avatarPath               String?                   @map("avatar_path")
  status                   AccountStatus             @default(PENDING)
  locale                   String                    @default("en-IN")
  timezone                 String                    @default("Asia/Kolkata")
  lastLoginAt              DateTime?                 @map("last_login_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  roles                    UserRole[]
  customer                 CustomerProfile?
  sitter                   SitterProfile?
  addresses                Address[]
  pets                     Pet[]
  bookings                 Booking[]                 @relation("CustomerBookings")
  reviews                  Review[]
  consents                 Consent[]
  notifications            NotificationOutbox[]
  accountRequests          AccountRequest[]
  partnerOrders            PartnerOrder[]            @relation("PartnerOrderCustomer")
  loyaltyEntries           LoyaltyLedger[]
  referralsMade            Referral[]                @relation("ReferralReferrer")
  referralReceived         Referral?                 @relation("ReferralReferred")
  testimonials             Testimonial[]
  testimonialConsents      TestimonialConsent[]
  permissionsHeld          AdminPermission[]         @relation("PermissionHolder")
  householdsOwned          HouseholdMember[]         @relation("HouseholdOwner")
  householdMemberships     HouseholdMember[]         @relation("HouseholdMember")
  complaints               Complaint[]
  communicationPreferences CommunicationPreference[]
  supportCases             SupportCase[]
  reportsReviewed          BookingReport[]           @relation("ReportReviewer")
  serviceCredits           ServiceCredit[]

  // Phase 13 B2B relations
  ownedOrganizations   Organization[]        @relation("OrgAccountOwner")
  ownedOpportunities   B2bOpportunity[]      @relation("OpportunityOwner")
  managedProgrammes    PartnerProgramme[]    @relation("ProgrammeManager")
  programmeMemberships ProgrammeMembership[]

  // Phase 14 Scale & Ops
  managedCities CityManager[]

  // Phase 14 Sprint 4 — DPDP Privacy
  consentRecords          ContentConsentRecord[] @relation("UserConsents")
  dataSubjectRequests     DataSubjectRequest[]   @relation("UserDataRequests")
  handledDataRequests     DataSubjectRequest[]   @relation("HandledDataRequests")
  // Phase 14 Sprint 3
  operatingPartnerContact OperatingPartner[]     @relation("OperatorContact")
  // Phase 14 Sprint 2
  suspensions             ProviderSuspension[]   @relation("SitterSuspensions")
  liftedSuspensions       ProviderSuspension[]   @relation("SuspensionLifter")
  auditsReceived          SafetyAudit[]          @relation("SitterAudits")
  auditsPerformed         SafetyAudit[]          @relation("AuditorUsers")

  @@map("users")
}

model AccountRequest {
  id          String               @id @default(uuid()) @db.Uuid
  reference   String               @unique
  userId      String               @map("user_id") @db.Uuid
  type        AccountRequestType
  status      AccountRequestStatus @default(RECEIVED)
  details     Json
  handledBy   String?              @map("handled_by") @db.Uuid
  resolution  String?
  requestedAt DateTime             @default(now()) @map("requested_at")
  verifiedAt  DateTime?            @map("verified_at")
  fulfilledAt DateTime?            @map("fulfilled_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, requestedAt])
  @@index([type, status, requestedAt])
  @@map("account_requests")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model Consent {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String
  policyVersion String    @map("policy_version")
  granted       Boolean
  capturedAt    DateTime  @default(now()) @map("captured_at")
  withdrawnAt   DateTime? @map("withdrawn_at")
  evidence      Json?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("consents")
}

model CustomerProfile {
  id                    String  @id @default(uuid()) @db.Uuid
  userId                String  @unique @map("user_id") @db.Uuid
  preferredLanguage     String  @default("en") @map("preferred_language")
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model SitterProfile {
  id                     String                    @id @default(uuid()) @db.Uuid
  userId                 String                    @unique @map("user_id") @db.Uuid
  status                 SitterStatus              @default(APPLICANT)
  bio                    String?
  yearsExperience        Int                       @default(0) @map("years_experience")
  serviceLocality        String?                   @map("service_locality")
  serviceRadiusKm        Decimal                   @default(5) @map("service_radius_km") @db.Decimal(5, 2)
  reliabilityScore       Decimal?                  @map("reliability_score") @db.Decimal(5, 2)
  applicationAt          DateTime                  @default(now()) @map("application_at")
  approvedAt             DateTime?                 @map("approved_at")
  suspendedAt            DateTime?                 @map("suspended_at")
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions            SitterServicePermission[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  verifications          SitterVerification[]
  trainingAttempts       TrainingAttempt[]
  assignments            BookingAssignment[]
  payouts                Payout[]
  societyPools           SocietySitterPool[]
  applications           SitterApplication[]
  practicalAssessments   PracticalAssessment[]
  boardingProperties     BoardingProperty[]
  reliabilityHistory     ReliabilityScore[]
  complaints             Complaint[]
  holds                  SitterHold[]
  matchScores            MatchScore[]

  @@index([status])
  @@map("sitter_profiles")
}

model Address {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String?            @map("user_id") @db.Uuid
  label              String
  line1              String
  line2              String?
  landmark           String?
  locality           String
  city               String
  state              String
  postalCode         String             @map("postal_code")
  countryCode        String             @default("IN") @map("country_code")
  latitude           Decimal?           @db.Decimal(10, 7)
  longitude          Decimal?           @db.Decimal(10, 7)
  geocodeProvider    String?            @map("geocode_provider")
  geocodeRef         String?            @map("geocode_ref")
  accessNotes        String?            @map("access_notes")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  boardingProperties BoardingProperty[]

  // Phase 13 B2B relations
  orgBillingFor Organization[]

  @@index([city, locality])
  @@map("addresses")
}

model Pet {
  id                   String                @id @default(uuid()) @db.Uuid
  ownerId              String                @map("owner_id") @db.Uuid
  name                 String
  species              String
  breed                String?
  sex                  String?
  birthDate            DateTime?             @map("birth_date") @db.Date
  weightKg             Decimal?              @map("weight_kg") @db.Decimal(6, 2)
  sterilised           Boolean?
  photoPath            String?               @map("photo_path")
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  medicalProfile       PetMedicalProfile?
  emergencyContacts    PetEmergencyContact[]
  riskAssessments      PetRiskAssessment[]
  bookings             Booking[]
  partnerOrders        PartnerOrder[]
  media                PetMedia[]
  careInstructions     CareInstruction[]
  medications          Medication[]
  vaccinations         Vaccination[]
  healthEvents         PetHealthEvent[]
  healthTimelineEvents HealthTimelineEvent[]

  @@index([ownerId, active])
  @@map("pets")
}

model PetMedicalProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  petId                String   @unique @map("pet_id") @db.Uuid
  allergies            String?
  conditions           String?
  medications          String?
  veterinarianName     String?  @map("veterinarian_name")
  veterinarianPhone    String?  @map("veterinarian_phone")
  emergencyClinicName  String?  @map("emergency_clinic_name")
  emergencyClinicPhone String?  @map("emergency_clinic_phone")
  updatedAt            DateTime @updatedAt @map("updated_at")
  pet                  Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_medical_profiles")
}

model PetEmergencyContact {
  id       String  @id @default(uuid()) @db.Uuid
  petId    String  @map("pet_id") @db.Uuid
  name     String
  phone    String
  relation String?
  priority Int     @default(1)
  pet      Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, priority])
  @@map("pet_emergency_contacts")
}

model PetRiskAssessment {
  id             String          @id @default(uuid()) @db.Uuid
  petId          String          @map("pet_id") @db.Uuid
  serviceCode    ServiceCode     @map("service_code")
  suggestedLevel RiskLevel       @default(UNASSESSED) @map("suggested_level")
  finalLevel     RiskLevel       @default(UNASSESSED) @map("final_level")
  factorSnapshot Json            @map("factors")
  reviewedBy     String?         @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?       @map("reviewed_at")
  expiresAt      DateTime?       @map("expires_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  factors        PetRiskFactor[]

  @@index([petId, serviceCode, createdAt])
  @@map("pet_risk_assessments")
}

model ServiceType {
  id                        String                     @id @default(uuid()) @db.Uuid
  code                      ServiceCode                @unique
  name                      String
  description               String
  durationMinutes           Int?                       @map("duration_minutes")
  active                    Boolean                    @default(false)
  requiresManualMatch       Boolean                    @default(true) @map("requires_manual_match")
  requiresProperty          Boolean                    @default(false) @map("requires_property")
  basePricePaise            Int                        @map("base_price_paise")
  currency                  String                     @default("INR")
  permissions               SitterServicePermission[]
  bookings                  Booking[]
  variants                  ServiceVariant[]
  prices                    ServicePrice[]
  cityServiceConfigurations CityServiceConfiguration[]
  zoneServiceConfigurations ZoneServiceConfiguration[]

  @@map("service_types")
}

model SitterServicePermission {
  id            String           @id @default(uuid()) @db.Uuid
  sitterId      String           @map("sitter_id") @db.Uuid
  serviceTypeId String           @map("service_type_id") @db.Uuid
  status        PermissionStatus @default(PENDING)
  riskLimit     RiskLevel        @default(GREEN) @map("risk_limit")
  grantedBy     String?          @map("granted_by") @db.Uuid
  grantedAt     DateTime?        @map("granted_at")
  expiresAt     DateTime?        @map("expires_at")
  revokedAt     DateTime?        @map("revoked_at")
  reason        String?
  sitter        SitterProfile    @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  serviceType   ServiceType      @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  @@unique([sitterId, serviceTypeId])
  @@index([serviceTypeId, status])
  @@map("sitter_service_permissions")
}

model AvailabilityRule {
  id        String        @id @default(uuid()) @db.Uuid
  sitterId  String        @map("sitter_id") @db.Uuid
  weekday   Int
  startTime String        @map("start_time")
  endTime   String        @map("end_time")
  timezone  String        @default("Asia/Kolkata")
  active    Boolean       @default(true)
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)

  @@index([sitterId, weekday])
  @@map("availability_rules")
}

model AvailabilityException {
  id        String        @id @default(uuid()) @db.Uuid
  sitterId  String        @map("sitter_id") @db.Uuid
  startsAt  DateTime      @map("starts_at")
  endsAt    DateTime      @map("ends_at")
  available Boolean
  reason    String?
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)

  @@index([sitterId, startsAt, endsAt])
  @@map("availability_exceptions")
}

model SitterVerification {
  id           String             @id @default(uuid()) @db.Uuid
  sitterId     String             @map("sitter_id") @db.Uuid
  type         String
  status       VerificationStatus @default(PENDING)
  provider     String?
  evidencePath String?            @map("evidence_path")
  checkedBy    String?            @map("checked_by") @db.Uuid
  checkedAt    DateTime?          @map("checked_at")
  expiresAt    DateTime?          @map("expires_at")
  revokedAt    DateTime?          @map("revoked_at")
  publicLabel  String?            @map("public_label")
  sitter       SitterProfile      @relation(fields: [sitterId], references: [id], onDelete: Cascade)

  @@index([sitterId, type, status])
  @@map("sitter_verifications")
}

model TrainingModule {
  id           String            @id @default(uuid()) @db.Uuid
  slug         String            @unique
  title        String
  version      Int
  passingScore Int               @map("passing_score")
  active       Boolean           @default(true)
  attempts     TrainingAttempt[]

  @@unique([slug, version])
  @@map("training_modules")
}

model TrainingAttempt {
  id          String         @id @default(uuid()) @db.Uuid
  sitterId    String         @map("sitter_id") @db.Uuid
  moduleId    String         @map("module_id") @db.Uuid
  score       Int
  passed      Boolean
  attemptedAt DateTime       @default(now()) @map("attempted_at")
  sitter      SitterProfile  @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@index([sitterId, moduleId, attemptedAt])
  @@map("training_attempts")
}

model Booking {
  id                      String                   @id @default(uuid()) @db.Uuid
  reference               String                   @unique
  customerId              String                   @map("customer_id") @db.Uuid
  petId                   String                   @map("pet_id") @db.Uuid
  serviceTypeId           String                   @map("service_type_id") @db.Uuid
  addressId               String                   @map("address_id") @db.Uuid
  status                  BookingStatus            @default(DRAFT)
  scheduledStart          DateTime                 @map("scheduled_start")
  scheduledEnd            DateTime                 @map("scheduled_end")
  timezone                String                   @default("Asia/Kolkata")
  customerNotes           String?                  @map("customer_notes")
  quoteAmountPaise        Int                      @map("quote_amount_paise")
  currency                String                   @default("INR")
  matchingNotes           String?                  @map("matching_notes")
  customerApprovedAt      DateTime?                @map("customer_approved_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
