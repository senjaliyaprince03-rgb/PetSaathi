C:\Users\Prince\.gemini\antigravity\brain\5edaf3a4-d4d2-487e-b3fa-8d2b4dcff141\.system_generated\logs\transcript_full.jsonl:6392:{"step_index":6458,"source":"USER_EXPLICIT","type":"USER_INPUT","status":"DONE","created_at":"2026-09-08T06:49:02Z","content":"<USER_REQUEST>\n<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\"/>\r\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>\r\n<title>PetSaathi — Super Master Prompt & Action Plan</title>\r\n<style>\r\n  :root{\r\n    --bg:#0d1117;--surface:#161b22;--surface2:#1f2937;--border:#30363d;\r\n    --accent:#f97316;--accent2:#fb923c;--green:#22c55e;--red:#ef4444;\r\n    --yellow:#facc15;--blue:#60a5fa;--purple:#a78bfa;\r\n    --text:#e6edf3;--muted:#8b949e;--code-bg:#0d1117;\r\n    --sidebar-w:260px;\r\n  }\r\n  *{box-sizing:border-box;margin:0;padding:0;}\r\n  body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh;font-size:15px;line-height:1.7;}\r\n\r\n  /* ── SIDEBAR ── */\r\n  aside{width:var(--sidebar-w);min-width:var(--sidebar-w);background:var(--surface);border-right:1px solid var(--border);height:100vh;position:sticky;top:0;overflow-y:auto;padding:0 0 40px;}\r\n  .sidebar-logo{padding:20px 16px 16px;border-bottom:1px solid var(--border);font-size:13px;font-weight:700;color:var(--accent);letter-spacing:.5px;display:flex;align-items:center;gap:8px;}\r\n  .sidebar-logo span{font-size:20px;}\r\n  nav a{display:block;padding:9px 16px 9px 20px;color:var(--muted);text-decoration:none;font-size:13px;border-left:3px solid transparent;transition:.15s;}\r\n  nav a:hover,nav a.active{color:var(--text);border-left-color:var(--accent);background:rgba(249,115,22,.07);}\r\n  .nav-group{padding:16px 16px 6px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted);}\r\n\r\n  /* ── MAIN ── */\r\n  main{flex:1;padding:40px 48px;max-width:1000px;}\r\n\r\n  h1{font-size:28px;font-weight:800;color:var(--accent);margin-bottom:6px;}\r\n  .subtitle{color:var(--muted);font-size:14px;margin-bottom:36px;}\r\n  h2{font-size:20px;font-weight:700;margin:48px 0 16px;padding-top:8px;color:var(--text);border-bottom:1px solid var(--border);padding-bottom:10px;}\r\n  h3{font-size:16px;font-weight:700;color:var(--accent2);margin:24px 0 10px;}\r\n  h4{font-size:14px;font-weight:700;color:var(--blue);margin:18px 0 8px;}\r\n  p{margin-bottom:12px;color:#c9d1d9;}\r\n\r\n  /* ── MEGA PROMPT BOX ── */\r\n  .mega-prompt{background:linear-gradient(135deg,#0d1f12 0%,#0f1a2e 100%);border:1.5px solid var(--green);border-radius:12px;padding:24px 28px;margin:20px 0 32px;position:relative;}\r\n  .mega-prompt-label{position:absolute;top:-12px;left:20px;background:#0d1f12;padding:2px 12px;border:1.5px solid var(--green);border-radius:20px;font-size:11px;font-weight:700;color:var(--green);letter-spacing:.5px;}\r\n  .mega-prompt p{font-family:'Fira Code','JetBrains Mono',monospace;font-size:13px;color:#86efac;line-height:1.8;margin:0;}\r\n  .copy-btn{position:absolute;top:12px;right:12px;background:var(--surface2);border:1px solid var(--border);color:var(--muted);padding:4px 12px;border-radius:6px;font-size:11px;cursor:pointer;transition:.15s;}\r\n  .copy-btn:hover{color:var(--text);border-color:var(--accent);}\r\n\r\n  /* ── SCORE PILLS ── */\r\n  .score-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:20px 0 32px;}\r\n  .score-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center;}\r\n  .score-val{font-size:32px;font-weight:800;margin-bottom:4px;}\r\n  .score-label{font-size:11px;color:var(--muted);}\r\n  .red{color:var(--red);}\r\n  .yellow{color:var(--yellow);}\r\n  .green-text{color:var(--green);}\r\n\r\n  /* ── ISSUE CARDS ── */\r\n  .issue{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px 20px;margin:14px 0;}\r\n  .issue-header{display:flex;align-items:center;gap:10px;margin-bottom:10px;}\r\n  .badge{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;}\r\n  .badge-critical{background:#7f1d1d;color:#fca5a5;}\r\n  .badge-high{background:#78350f;color:#fcd34d;}\r\n  .badge-medium{background:#1e3a5f;color:#93c5fd;}\r\n  .badge-low{background:#1e3a2f;color:#86efac;}\r\n  .issue-title{font-weight:700;font-size:15px;}\r\n\r\n  /* ── CODE ── */\r\n  pre{background:var(--code-bg);border:1px solid var(--border);border-radius:8px;padding:16px 18px;margin:12px 0;overflow-x:auto;font-family:'Fira Code','JetBrains Mono',monospace;font-size:13px;line-height:1.6;}\r\n  code{font-family:'Fira Code','JetBrains Mono',monospace;font-size:13px;}\r\n  .kw{color:#ff7b72;}\r\n  .str{color:#a5d6ff;}\r\n  .fn{color:#d2a8ff;}\r\n  .cm{color:var(--muted);}\r\n  .num{color:#79c0ff;}\r\n  .tag{color:#7ee787;}\r\n  .attr{color:#ffa657;}\r\n  .val{color:#a5d6ff;}\r\n\r\n  /* ── CALLOUT BOXES ── */\r\n  .callout{border-radius:8px;padding:14px 16px;margin:16px 0;display:flex;gap:12px;align-items:flex-start;}\r\n  .callout-warn{background:#2d1f00;border-left:3px solid var(--yellow);}\r\n  .callout-tip{background:#0d1f12;border-left:3px solid var(--green);}\r\n  .callout-info{background:#0d1a2e;border-left:3px solid var(--blue);}\r\n  .callout-danger{background:#1f0d0d;border-left:3px solid var(--red);}\r\n  .callout-icon{font-size:18px;line-height:1;}\r\n  .callout-body{font-size:13px;color:#c9d1d9;line-height:1.6;}\r\n  .callout-body strong{color:var(--text);}\r\n\r\n  /* ── STEPS ── */\r\n  .steps{counter-reset:step;list-style:none;margin:12px 0;}\r\n  .steps li{counter-increment:step;padding:10px 0 10px 44px;position:relative;border-bottom:1px solid var(--border);font-size:14px;}\r\n  .steps li:last-child{border-bottom:none;}\r\n  .steps li::before{content:counter(step);position:absolute;left:0;top:10px;width:28px;height:28px;background:var(--accent);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;}\r\n\r\n  /* ── COLLAPSIBLE Q&A ── */\r\n  details{background:var(--surface);border:1px solid var(--border);border-radius:8px;margin:10px 0;}\r\n  summary{padding:14px 16px;cursor:pointer;font-weight:600;font-size:14px;list-style:none;display:flex;align-items:center;gap:8px;}\r\n  summary::before{content:'▶';font-size:10px;color:var(--accent);transition:.2s;}\r\n  details[open] summary::before{content:'▼';}\r\n  details .qa-body{padding:0 16px 14px;border-top:1px solid var(--border);font-size:13px;color:#c9d1d9;line-height:1.7;}\r\n  details .qa-body pre{margin:10px 0;}\r\n\r\n  /* ── TABLE ── */\r\n  table{width:100%;border-collapse:collapse;font-size:13px;margin:14px 0;}\r\n  th{background:var(--surface2);padding:10px 14px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--border);}\r\n  td{padding:10px 14px;border-bottom:1px solid var(--border);color:#c9d1d9;}\r\n  tr:last-child td{border-bottom:none;}\r\n  tr:hover td{background:rgba(255,255,255,.02);}\r\n\r\n  /* ── PRIORITY CHECKLIST ── */\r\n  .checklist{list-style:none;}\r\n  .checklist li{padding:8px 0 8px 30px;position:relative;border-bottom:1px solid var(--border);font-size:13px;}\r\n  .checklist li::before{content:'☐';position:absolute;left:0;color:var(--muted);font-size:16px;}\r\n  .checklist li:last-child{border-bottom:none;}\r\n\r\n  /* ── TAG CHIPS ── */\r\n  .chip{display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:600;margin:2px;}\r\n  .chip-perf{background:#1e3a2f;color:#86efac;}\r\n  .chip-seo{background:#1e3a5f;color:#93c5fd;}\r\n  .chip-ux{background:#2d1f00;color:#fcd34d;}\r\n  .chip-content{background:#2d0d1f;color:#f9a8d4;}\r\n  .chip-code{background:#1a1a2e;color:#a78bfa;}\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<!-- ═══════════ SIDEBAR ═══════════ -->\r\n<aside>\r\n  <div class=\"sidebar-logo\"><span>🐾</span> PetSaathi Fix Plan</div>\r\n  <nav>\r\n    <div class=\"nav-group\">🚀 Master Prompt</div>\r\n    <a href=\"#master-prompt\">Copy the Super Prompt</a>\r\n\r\n    <div class=\"nav-group\">📊 Site Analysis</div>\r\n    <a href=\"#scores\">Score Breakdown</a>\r\n    <a href=\"#site-audit\">Full Site Audit</a>\r\n\r\n    <div class=\"nav-group\">🔥 Critical Fixes</div>\r\n    <a href=\"#content-bugs\">Content Bugs (Urgent)</a>\r\n    <a href=\"#performance\">Performance</a>\r\n    <a href=\"#images\">Image Optimization</a>\r\n    <a href=\"#seo\">SEO Fixes</a>\r\n\r\n    <div class=\"nav-group\">⚡ Code Fixes</div>\r\n    <a href=\"#lazy-loading\">Lazy Loading</a>\r\n    <a href=\"#fonts\">Font Loading</a>\r\n    <a href=\"#cls-fix\">CLS Fix</a>\r\n    <a href=\"#js-defer\">JS Defer</a>\r\n    <a href=\"#nextjs-tips\">Next.js / Vercel Tips</a>\r\n\r\n    <div class=\"nav-group\">🎨 UX Improvements</div>\r\n    <a href=\"#ux-mobile\">Mobile UX</a>\r\n    <a href=\"#cta\">CTA Improvements</a>\r\n    <a href=\"#trust\">Trust Signals</a>\r\n\r\n    <div class=\"nav-group\">✅ Checklist</div>\r\n    <a href=\"#final-checklist\">Priority Checklist</a>\r\n    <a href=\"#qa\">Q&A Deep Dives</a>\r\n  </nav>\r\n</aside>\r\n\r\n<!-- ═══════════ MAIN ═══════════ -->\r\n<main>\r\n\r\n  <h1>🐾 PetSaathi — Super Master Prompt</h1>\r\n  <p class=\"subtitle\">Full audit of <code>petsaathi.blue.vercel.app</code> (mobile) · PageSpeed Report · September 8, 2026</p>\r\n\r\n  <!-- ─── MASTER PROMPT ─── -->\r\n  <h2 id=\"master-prompt\">🚀 The Super Master Prompt</h2>\r\n  <p>Copy this <strong>entire prompt</strong> and paste it into a new Claude conversation along with your project's codebase or key files. It will guide Claude to fix everything found in the PageSpeed report + audit:</p>\r\n\r\n  <div class=\"mega-prompt\">\r\n    <div class=\"mega-prompt-label\">SUPER MASTER PROMPT — COPY THIS</div>\r\n    <button class=\"copy-btn\" onclick=\"copyPrompt()\">📋 Copy</button>\r\n    <p id=\"prompt-text\">\r\nYou are a senior full-stack engineer and performance specialist. I am working on PetSaathi — an Indian pet care services startup web app deployed on Vercel at petsaathi.blue.vercel.app. The app offers pet sitting, dog walking, PetConnect hangouts, event partnerships, and customized pet souvenirs — targeting Indian pet parents.\r\n\r\nI ran a Google PageSpeed Insights test (mobile) and need you to audit and fix the entire project. Work through ALL of the following areas in sequence. For each area, give me the EXACT code to change — no summaries, no \"consider doing X\", only copy-paste-ready code with file paths.\r\n\r\n════════════════════════════════════\r\nAREA 1 — CONTENT BUGS (Fix Immediately)\r\n════════════════════════════════════\r\n1. Remove ALL lorem ipsum / placeholder text from the FAQ section. Replace with real, India-specific pet care questions and answers.\r\n2. Remove dummy FAQ entries like \"fdsgdvcbv sdgsg fdg dfg\" — replace with meaningful content.\r\n3. Replace the fake phone number \"656456456\" with a proper placeholder like +91-XXXXXXXXXX or an actual number.\r\n4. Fill any empty or placeholder sections with real copy matching the PetSaathi brand voice.\r\n\r\n════════════════════════════════════\r\nAREA 2 — PERFORMANCE (PageSpeed Core Web Vitals)\r\n════════════════════════════════════\r\n5. Fix LCP (Largest Contentful Paint): The hero image must be preloaded. Add <link rel=\"preload\"> for the hero image. If using Next.js, add priority prop to the hero <Image>.\r\n6. Fix CLS (Cumulative Layout Shift): All <img> tags must have explicit width and height attributes. All Next.js <Image> components must have width and height props. Never use layout=\"fill\" without a fixed-height parent.\r\n7. Fix FID/INP: Identify and defer all non-critical JavaScript. Move analytics, chat widgets, and third-party scripts to load after the page is interactive.\r\n8. Fix TBT (Total Blocking Time): Remove unused JavaScript. Split large JS bundles with dynamic import().\r\n9. Fix FCP (First Contentful Paint): Inline critical CSS. Remove render-blocking stylesheets.\r\n\r\n════════════════════════════════════\r\nAREA 3 — IMAGE OPTIMIZATION\r\n════════════════════════════════════\r\n10. All images currently load from external domain qubetatechnolab.com — migrate them to the /public folder or use Vercel's Image Optimization.\r\n11. Convert all PNG/JPG images to WebP format. Provide the next.config.js settings for this.\r\n12. Add loading=\"lazy\" to all images that are below the fold.\r\n13. Add descriptive alt text to every image (use pet-care, India-specific descriptions).\r\n14. Set explicit width and height on every <img> tag to prevent CLS.\r\n15. Use srcset for responsive images.\r\n\r\n════════════════════════════════════\r\nAREA 4 — SEO\r\n════════════════════════════════════\r\n16. Add a complete <head> meta block: title, description, og:title, og:description, og:image, og:url, twitter:card, canonical URL, robots, viewport.\r\n17. Add JSON-LD structured data for LocalBusiness schema (pet care service, India).\r\n18. Add JSON-LD for each Service offered (Pet Sitting, Dog Walking, PetConnect, etc.).\r\n19. Create a sitemap.xml and robots.txt. Provide the Next.js route for sitemap.xml generation.\r\n20. Add breadcrumb schema for inner pages.\r\n\r\n════════════════════════════════════\r\nAREA 5 — NEXT.JS / VERCEL SPECIFIC\r\n════════════════════════════════════\r\n21. Show me the complete next.config.js with: image domains whitelist, WebP output, compression enabled, headers for cache-control on static assets.\r\n22. Show me how to add Vercel Speed Insights and Vercel Analytics to the _app.js / layout.js.\r\n23. Add a service worker for offline caching of static assets.\r\n24. Enable ISR (Incremental Static Regeneration) on blog/service pages.\r\n\r\n════════════════════════════════════\r\nAREA 6 — MOBILE UX\r\n════════════════════════════════════\r\n25. Review and fix the mobile nav — hamburger menu must work with no JavaScript lag.\r\n26. All tap targets (buttons, links) must be at minimum 44×44px. Show me CSS fix.\r\n27. Font sizes: body min 16px on mobile, no text smaller than 12px anywhere.\r\n28. Add a sticky \"Book Now\" CTA button on mobile that follows the user as they scroll.\r\n29. Fix the \"Join Waitlist\" form — add proper validation, loading state, and success message.\r\n\r\n════════════════════════════════════\r\nAREA 7 — TRUST & CONVERSION\r\n════════════════════════════════════\r\n30. Add a reviews/testimonials section with star ratings (use JSON data, no external API needed for now).\r\n31. Add partner count / pets served / cities stats to the hero or about section.\r\n32. Add a \"How It Works\" section with proper 3-step flow and icons.\r\n33. Add an FAQ section with accordion/collapsible answers — 8 real questions.\r\n34. Add a WhatsApp floating button for Indian users (+91 contact).\r\n\r\nGive me code for EVERY item above. Start with Area 1, then go through in order. Do not skip any item. Use React/Next.js code where applicable, or plain HTML/CSS if the project is not React-based. Ask me for the framework/stack if unclear.\r\n    </p>\r\n  </div>\r\n\r\n  <script>\r\n    function copyPrompt(){\r\n      const txt = document.getElementById('prompt-text').innerText;\r\n      navigator.clipboard.writeText(txt).then(()=>{\r\n        const btn = document.querySelector('.copy-btn');\r\n        btn.textContent='✅ Copied!';\r\n        setTimeout(()=>btn.textContent='📋 Copy',2000);\r\n      });\r\n    }\r\n  </script>\r\n\r\n  <!-- ─── SCORES ─── -->\r\n  <h2 id=\"scores\">📊 Estimated PageSpeed Score Breakdown (Mobile)</h2>\r\n  <p>The report data is JavaScript-rendered so exact numbers weren't extractable — but based on the site audit below, these are the <strong>estimated scores</strong> matching the issues found:</p>\r\n\r\n  <div class=\"score-grid\">\r\n    <div class=\"score-card\">\r\n      <div class=\"score-val red\">~38</div>\r\n      <div class=\"score-label\">Performance</div>\r\n    </div>\r\n    <div class=\"score-card\">\r\n      <div class=\"score-val yellow\">~65</div>\r\n      <div class=\"score-label\">Accessibility</div>\r\n    </div>\r\n    <div class=\"score-card\">\r\n      <div class=\"score-val yellow\">~72</div>\r\n      <div class=\"score-label\">Best Practices</div>\r\n    </div>\r\n    <div class=\"score-card\">\r\n      <div class=\"score-val red\">~45</div>\r\n      <div class=\"score-label\">SEO</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"callout callout-info\">\r\n    <div class=\"callout-icon\">ℹ️</div>\r\n    <div class=\"callout-body\"><strong>Why these estimates?</strong> External images (qubetatechnolab.com), no image dimensions, placeholder content in production, missing meta tags, and no structured data are the main score killers across all four categories.</div>\r\n  </div>\r\n\r\n  <!-- ─── SITE AUDIT ─── -->\r\n  <h2 id=\"site-audit\">🔍 Full Site Audit — What Was Found</h2>\r\n  <table>\r\n    <thead>\r\n      <tr><th>Category</th><th>Issue Found</th><th>Severity</th><th>Impact</th></tr>\r\n    </thead>\r\n    <tbody>\r\n      <tr><td>Content</td><td>Lorem ipsum in FAQ section</td><td><span class=\"badge badge-critical\">CRITICAL</span></td><td>Trust killer, looks unfinished</td></tr>\r\n      <tr><td>Content</td><td>\"fdsgdvcbv sdgsg\" placeholder text in production</td><td><span class=\"badge badge-critical\">CRITICAL</span></td><td>Immediate credibility damage</td></tr>\r\n      <tr><td>Content</td><td>Fake phone number \"656456456\"</td><td><span class=\"badge badge-critical\">CRITICAL</span></td><td>Users can't contact you</td></tr>\r\n      <tr><td>Performance</td><td>All images from external domain (qubetatechnolab.com)</td><td><span class=\"badge badge-high\">HIGH</span></td><td>Extra DNS lookup, slow LCP</td></tr>\r\n      <tr><td>Performance</td><td>No image width/height attributes</td><td><span class=\"badge badge-high\">HIGH</span></td><td>CLS layout shift</td></tr>\r\n      <tr><td>Performance</td><td>SVG icons loaded from external server</td><td><span class=\"badge badge-high\">HIGH</span></td><td>Extra network requests</td></tr>\r\n      <tr><td>SEO</td><td>No visible meta description or OG tags</td><td><span class=\"badge badge-high\">HIGH</span></td><td>Poor search snippet + social share</td></tr>\r\n      <tr><td>SEO</td><td>No JSON-LD structured data</td><td><span class=\"badge badge-high\">HIGH</span></td><td>No rich results in Google</td></tr>\r\n      <tr><td>UX</td><td>\"Join Waitlist\" suggests app not launched</td><td><span class=\"badge badge-medium\">MEDIUM</span></td><td>Reduces urgency, no conversion</td></tr>\r\n      <tr><td>UX</td><td>No visible reviews/testimonials</td><td><span class=\"badge badge-medium\">MEDIUM</span></td><td>Low social proof</td></tr>\r\n      <tr><td>UX</td><td>No WhatsApp button (huge miss for India)</td><td><span class=\"badge badge-medium\">MEDIUM</span></td><td>Missed Indian user behavior</td></tr>\r\n      <tr><td>Performance</td><td>No lazy loading on below-fold images</td><td><span class=\"badge badge-medium\">MEDIUM</span></td><td>Slower initial load</td></tr>\r\n    </tbody>\r\n  </table>\r\n\r\n  <!-- ─── CONTENT BUGS ─── -->\r\n  <h2 id=\"content-bugs\">🚨 AREA 1: Content Bugs (Fix Before Anything Else)</h2>\r\n\r\n  <div class=\"callout callout-danger\">\r\n    <div class=\"callout-icon\">🔴</div>\r\n    <div class=\"callout-body\"><strong>Your site currently has lorem ipsum and gibberish text in production.</strong> This is the first thing to fix — no performance fix matters if users land on a page with placeholder text. Fix this TODAY.</div>\r\n  </div>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-critical\">CRITICAL</span>\r\n      <span class=\"issue-title\">Replace Lorem Ipsum FAQs</span>\r\n      <span class=\"chip chip-content\">Content</span>\r\n    </div>\r\n    <p>Current broken FAQ entries found on live site:</p>\r\n    <pre><code><span class=\"cm\">/* ❌ CURRENT (broken — placeholder text in production) */</span>\r\nFAQ: \"In et finibus lectus. Donec scelerisque tortor?\"\r\n     \"Pellentesque maximus augue orci, quis congue...\"\r\n\r\nFAQ: \"fdsgdvcbv sdgsg fdg dfg\"\r\n     \"dghgdhgh gsdfgdfg dfgdsgdsgdf temporibus...\"\r\n\r\nFAQ: \"Lorem ipsum dolor sit amet consectetur...\"\r\n     \"temporibus, nobis neque modi numquam dicta...\"</code></pre>\r\n\r\n    <h4>✅ Replace with these real FAQs (India-specific):</h4>\r\n    <pre><code><span class=\"cm\">// faqData.js — Real FAQ content for PetSaathi</span>\r\n<span class=\"kw\">export const</span> faqs = [\r\n  {\r\n    q: <span class=\"str\">\"How do I book a pet sitting session?\"</span>,\r\n    a: <span class=\"str\">\"Download the PetSaathi app, create a profile for your pet, and browse verified partners near you. Pick a time slot, confirm the booking, and receive live GPS updates during the session.\"</span>\r\n  },\r\n  {\r\n    q: <span class=\"str\">\"Are PetSaathi Partners background verified?\"</span>,\r\n    a: <span class=\"str\">\"Yes. Every PetSaathi Partner goes through ID verification, reference checks, and a pet-handling assessment before going live on the platform. We also enforce a no-phone policy during walks.\"</span>\r\n  },\r\n  {\r\n    q: <span class=\"str\">\"What cities is PetSaathi available in?\"</span>,\r\n    a: <span class=\"str\">\"We are currently launching in select neighbourhoods. Join our waitlist to be notified when we go live in your area.\"</span>\r\n  },\r\n  {\r\n    q: <span class=\"str\">\"How much does dog walking cost?\"</span>,\r\n    a: <span class=\"str\">\"Pricing varies by city and session length. A standard 30-minute walk starts at ₹199. You can see exact pricing after entering your location in the app.\"</span>\r\n  },\r\n  {\r\n    q: <span class=\"str\">\"What is PetConnect?\"</span>,\r\n    a: <span class=\"str\">\"PetConnect is a first-of-its-kind service in India — it lets pet lovers who don't own pets spend quality time with your dog, supervised and verified. It's a win-win: your pet gets extra love and the partner gets joy.\"</span>\r\n  },\r\n  {\r\n    q: <span class=\"str\">\"Is my pet insured during a session?\"</span>,\r\n    a: <span class=\"str\">\"All PetSaathi sessions are covered under our partner protection policy. Any incident during a verified session is handled by our support team immediately.\"</span>\r\n  },\r\n  {\r\n    q: <span class=\"str\">\"How do I become a PetSaathi Partner?\"</span>,\r\n    a: <span class=\"str\">\"Click 'Become a Partner', fill the application form, complete the verification process, and attend a brief onboarding session. You can start earning from flexible hours within a week.\"</span>\r\n  },\r\n  {\r\n    q: <span class=\"str\">\"Can I track my dog in real time during a walk?\"</span>,\r\n    a: <span class=\"str\">\"Yes. Every walk session includes live GPS tracking, mid-walk photo updates, and a post-walk report card — all visible inside the PetSaathi app.\"</span>\r\n  }\r\n];\r\n</code></pre>\r\n  </div>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-critical\">CRITICAL</span>\r\n      <span class=\"issue-title\">Fix the Phone Number</span>\r\n      <span class=\"chip chip-content\">Content</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">/* ❌ Current */</span>\r\n&lt;<span class=\"tag\">a</span> <span class=\"attr\">href</span>=<span class=\"val\">\"tel:656456456\"</span>&gt;656456456&lt;/<span class=\"tag\">a</span>&gt;\r\n\r\n<span class=\"cm\">/* ✅ Fix — use real number or hide until launch */</span>\r\n&lt;<span class=\"tag\">a</span> <span class=\"attr\">href</span>=<span class=\"val\">\"tel:+911234567890\"</span> <span class=\"attr\">class</span>=<span class=\"val\">\"phone-link\"</span>&gt;+91-12345 67890&lt;/<span class=\"tag\">a</span>&gt;\r\n\r\n<span class=\"cm\">/* OR redirect to WhatsApp if no call center yet */</span>\r\n&lt;<span class=\"tag\">a</span> <span class=\"attr\">href</span>=<span class=\"val\">\"https://wa.me/91XXXXXXXXXX?text=Hi%20PetSaathi%2C%20I%20need%20help\"</span>\r\n   <span class=\"attr\">target</span>=<span class=\"val\">\"_blank\"</span>&gt;Chat on WhatsApp&lt;/<span class=\"tag\">a</span>&gt;</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── PERFORMANCE ─── -->\r\n  <h2 id=\"performance\">⚡ AREA 2: Performance — Core Web Vitals</h2>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-high\">HIGH</span>\r\n      <span class=\"issue-title\">Fix LCP — Hero Image Preload</span>\r\n      <span class=\"chip chip-perf\">Performance</span>\r\n    </div>\r\n    <h4>Option A — Plain HTML</h4>\r\n    <pre><code><span class=\"cm\">&lt;!-- Add this in &lt;head&gt; BEFORE all other tags --&gt;</span>\r\n&lt;<span class=\"tag\">link</span>\r\n  <span class=\"attr\">rel</span>=<span class=\"val\">\"preload\"</span>\r\n  <span class=\"attr\">as</span>=<span class=\"val\">\"image\"</span>\r\n  <span class=\"attr\">href</span>=<span class=\"val\">\"/images/hero-dog.webp\"</span>\r\n  <span class=\"attr\">imagesrcset</span>=<span class=\"val\">\"/images/hero-dog-400.webp 400w, /images/hero-dog-800.webp 800w\"</span>\r\n  <span class=\"attr\">imagesizes</span>=<span class=\"val\">\"(max-width:600px) 100vw, 50vw\"</span>\r\n/&gt;</code></pre>\r\n\r\n    <h4>Option B — Next.js (Recommended for Vercel)</h4>\r\n    <pre><code><span class=\"kw\">import</span> Image <span class=\"kw\">from</span> <span class=\"str\">'next/image'</span>;\r\n\r\n<span class=\"cm\">// In your Hero component — priority tells Next.js to preload</span>\r\n&lt;<span class=\"tag\">Image</span>\r\n  <span class=\"attr\">src</span>=<span class=\"val\">\"/images/hero-dog.webp\"</span>\r\n  <span class=\"attr\">alt</span>=<span class=\"val\">\"Happy dog being walked by PetSaathi partner in India\"</span>\r\n  <span class=\"attr\">width</span>=<span class=\"val\">{800}</span>\r\n  <span class=\"attr\">height</span>=<span class=\"val\">{600}</span>\r\n  <span class=\"attr\">priority</span>           <span class=\"cm\">// ← This is the LCP fix</span>\r\n  <span class=\"attr\">quality</span>=<span class=\"val\">{85}</span>\r\n  <span class=\"attr\">className</span>=<span class=\"val\">\"hero-img\"</span>\r\n/&gt;</code></pre>\r\n  </div>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-high\">HIGH</span>\r\n      <span class=\"issue-title\">Fix CLS — Explicit Image Dimensions</span>\r\n      <span class=\"chip chip-perf\">Performance</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">/* ❌ Bad — causes layout shift */</span>\r\n&lt;<span class=\"tag\">img</span> <span class=\"attr\">src</span>=<span class=\"val\">\"dog.jpg\"</span>&gt;\r\n\r\n<span class=\"cm\">/* ✅ Good — browser reserves space before image loads */</span>\r\n&lt;<span class=\"tag\">img</span>\r\n  <span class=\"attr\">src</span>=<span class=\"val\">\"dog.webp\"</span>\r\n  <span class=\"attr\">width</span>=<span class=\"val\">\"800\"</span>\r\n  <span class=\"attr\">height</span>=<span class=\"val\">\"600\"</span>\r\n  <span class=\"attr\">alt</span>=<span class=\"val\">\"Pet sitter walking golden retriever in Mumbai\"</span>\r\n  <span class=\"attr\">loading</span>=<span class=\"val\">\"lazy\"</span>\r\n/&gt;\r\n\r\n<span class=\"cm\">/* CSS to maintain aspect ratio */</span>\r\n<span class=\"fn\">img</span> {\r\n  <span class=\"attr\">width</span>: <span class=\"num\">100%</span>;\r\n  <span class=\"attr\">height</span>: auto;\r\n  <span class=\"attr\">aspect-ratio</span>: attr(width) / attr(height); <span class=\"cm\">/* modern browsers */</span>\r\n}</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── IMAGES ─── -->\r\n  <h2 id=\"images\">🖼️ AREA 3: Image Optimization (Biggest Win)</h2>\r\n\r\n  <div class=\"callout callout-warn\">\r\n    <div class=\"callout-icon\">⚠️</div>\r\n    <div class=\"callout-body\"><strong>Root problem:</strong> All your images are served from <code>qubetatechnolab.com</code> — an external server. This means an extra DNS lookup, no Vercel CDN optimization, no WebP conversion, and no lazy loading control. Move images to your own <code>/public</code> folder or use Vercel Image Optimization.</div>\r\n  </div>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-high\">HIGH</span>\r\n      <span class=\"issue-title\">next.config.js — Enable Image Optimization</span>\r\n      <span class=\"chip chip-code\">Code</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">// next.config.js</span>\r\n<span class=\"cm\">/** @type {import('next').NextConfig} */</span>\r\n<span class=\"kw\">const</span> nextConfig = {\r\n  images: {\r\n    formats: [<span class=\"str\">'image/avif'</span>, <span class=\"str\">'image/webp'</span>], <span class=\"cm\">// serve AVIF → WebP → JPEG fallback</span>\r\n    remotePatterns: [\r\n      {\r\n        protocol: <span class=\"str\">'https'</span>,\r\n        hostname: <span class=\"str\">'qubetatechnolab.com'</span>,  <span class=\"cm\">// allow current CDN temporarily</span>\r\n        pathname: <span class=\"str\">'/public/PetSaathi/**'</span>,\r\n      },\r\n    ],\r\n    deviceSizes: [<span class=\"num\">360</span>, <span class=\"num\">414</span>, <span class=\"num\">768</span>, <span class=\"num\">1024</span>, <span class=\"num\">1280</span>], <span class=\"cm\">// India device breakpoints</span>\r\n    minimumCacheTTL: <span class=\"num\">86400</span>,  <span class=\"cm\">// cache images 24h</span>\r\n  },\r\n  compress: <span class=\"kw\">true</span>,\r\n  poweredByHeader: <span class=\"kw\">false</span>,\r\n  async headers() {\r\n    <span class=\"kw\">return</span> [\r\n      {\r\n        source: <span class=\"str\">'/:path*.{jpg,jpeg,png,gif,webp,avif,svg,ico}'</span>,\r\n        headers: [\r\n          { key: <span class=\"str\">'Cache-Control'</span>, value: <span class=\"str\">'public, max-age=31536000, immutable'</span> }\r\n        ],\r\n      },\r\n      {\r\n        source: <span class=\"str\">'/_next/static/:path*'</span>,\r\n        headers: [\r\n          { key: <span class=\"str\">'Cache-Control'</span>, value: <span class=\"str\">'public, max-age=31536000, immutable'</span> }\r\n        ],\r\n      },\r\n    ];\r\n  },\r\n};\r\n\r\n<span class=\"kw\">module.exports</span> = nextConfig;\r\n</code></pre>\r\n  </div>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-medium\">MEDIUM</span>\r\n      <span class=\"issue-title\">Batch Convert Existing Images to WebP</span>\r\n      <span class=\"chip chip-perf\">Performance</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\"># Run in your terminal — converts all JPG/PNG to WebP</span>\r\n<span class=\"cm\"># Install: npm install -g sharp-cli</span>\r\n\r\nfind public/images -name \"*.jpg\" -o -name \"*.png\" | \\\r\n  xargs -I{} sharp --input {} \\\r\n  --output {}.webp \\\r\n  --webp-quality 82 \\\r\n  --webp-lossless false\r\n\r\n<span class=\"cm\"># OR use squoosh-cli</span>\r\nnpx @squoosh/cli --webp '{\"quality\":82}' public/images/*.{jpg,png}\r\n</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── SEO ─── -->\r\n  <h2 id=\"seo\">🔍 AREA 4: SEO Fixes</h2>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-high\">HIGH</span>\r\n      <span class=\"issue-title\">Complete Meta Tags (Next.js App Router)</span>\r\n      <span class=\"chip chip-seo\">SEO</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">// app/layout.js OR pages/_app.js</span>\r\n<span class=\"kw\">import</span> { Metadata } <span class=\"kw\">from</span> <span class=\"str\">'next'</span>;\r\n\r\n<span class=\"kw\">export const</span> metadata: Metadata = {\r\n  title: <span class=\"str\">'PetSaathi — Trusted Pet Sitting & Dog Walking in India'</span>,\r\n  description: <span class=\"str\">'Book verified pet sitters, dog walkers, and PetConnect sessions in your city. Live GPS tracking, photo updates, and safe care for your pet. India\\'s most trusted pet care community.'</span>,\r\n  keywords: [<span class=\"str\">'pet sitter India'</span>, <span class=\"str\">'dog walking Mumbai'</span>, <span class=\"str\">'pet care Bangalore'</span>, <span class=\"str\">'PetSaathi'</span>],\r\n  openGraph: {\r\n    title: <span class=\"str\">'PetSaathi — Your Pet\\'s Trusted Companion'</span>,\r\n    description: <span class=\"str\">'Verified pet sitters & dog walkers near you. Live GPS + photo updates.'</span>,\r\n    url: <span class=\"str\">'https://www.petsaathi.in'</span>,\r\n    siteName: <span class=\"str\">'PetSaathi'</span>,\r\n    images: [{ url: <span class=\"str\">'https://www.petsaathi.in/og-image.png'</span>, width: <span class=\"num\">1200</span>, height: <span class=\"num\">630</span> }],\r\n    locale: <span class=\"str\">'en_IN'</span>,\r\n    type: <span class=\"str\">'website'</span>,\r\n  },\r\n  twitter: {\r\n    card: <span class=\"str\">'summary_large_image'</span>,\r\n    title: <span class=\"str\">'PetSaathi — Pet Care You Can Trust'</span>,\r\n    description: <span class=\"str\">'Verified pet sitters & dog walkers across India.'</span>,\r\n    images: [<span class=\"str\">'https://www.petsaathi.in/og-image.png'</span>],\r\n  },\r\n  robots: { index: <span class=\"kw\">true</span>, follow: <span class=\"kw\">true</span> },\r\n  alternates: { canonical: <span class=\"str\">'https://www.petsaathi.in'</span> },\r\n  verification: { google: <span class=\"str\">'YOUR_GOOGLE_SEARCH_CONSOLE_TOKEN'</span> },\r\n};\r\n</code></pre>\r\n  </div>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-high\">HIGH</span>\r\n      <span class=\"issue-title\">JSON-LD Structured Data — LocalBusiness + Services</span>\r\n      <span class=\"chip chip-seo\">SEO</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">// components/StructuredData.jsx</span>\r\n<span class=\"kw\">export default function</span> <span class=\"fn\">StructuredData</span>() {\r\n  <span class=\"kw\">const</span> schema = {\r\n    <span class=\"str\">\"@context\"</span>: <span class=\"str\">\"https://schema.org\"</span>,\r\n    <span class=\"str\">\"@type\"</span>: <span class=\"str\">\"LocalBusiness\"</span>,\r\n    <span class=\"str\">\"@id\"</span>: <span class=\"str\">\"https://www.petsaathi.in\"</span>,\r\n    <span class=\"str\">\"name\"</span>: <span class=\"str\">\"PetSaathi\"</span>,\r\n    <span class=\"str\">\"description\"</span>: <span class=\"str\">\"India's most trusted pet care ecosystem — verified pet sitting, dog walking, and PetConnect services.\"</span>,\r\n    <span class=\"str\">\"url\"</span>: <span class=\"str\">\"https://www.petsaathi.in\"</span>,\r\n    <span class=\"str\">\"logo\"</span>: <span class=\"str\">\"https://www.petsaathi.in/logo.png\"</span>,\r\n    <span class=\"str\">\"image\"</span>: <span class=\"str\">\"https://www.petsaathi.in/og-image.png\"</span>,\r\n    <span class=\"str\">\"areaServed\"</span>: { <span class=\"str\">\"@type\"</span>: <span class=\"str\">\"Country\"</span>, <span class=\"str\">\"name\"</span>: <span class=\"str\">\"India\"</span> },\r\n    <span class=\"str\">\"hasOfferCatalog\"</span>: {\r\n      <span class=\"str\">\"@type\"</span>: <span class=\"str\">\"OfferCatalog\"</span>,\r\n      <span class=\"str\">\"name\"</span>: <span class=\"str\">\"PetSaathi Services\"</span>,\r\n      <span class=\"str\">\"itemListElement\"</span>: [\r\n        { <span class=\"str\">\"@type\"</span>: <span class=\"str\">\"Offer\"</span>, <span class=\"str\">\"itemOffered\"</span>: { <span class=\"str\">\"@type\"</span>: <span class=\"str\">\"Service\"</span>, <span class=\"str\">\"name\"</span>: <span class=\"str\">\"Dog Walking\"</span> } },\r\n        { <span class=\"str\">\"@type\"</span>: <span class=\"str\">\"Offer\"</span>, <span class=\"str\">\"itemOffered\"</span>: { <span class=\"str\">\"@type\"</span>: <span class=\"str\">\"Service\"</span>, <span class=\"str\">\"name\"</span>: <span class=\"str\">\"Pet Sitting\"</span> } },\r\n        { <span class=\"str\">\"@type\"</span>: <span class=\"str\">\"Offer\"</span>, <span class=\"str\">\"itemOffered\"</span>: { <span class=\"str\">\"@type\"</span>: <span class=\"str\">\"Service\"</span>, <span class=\"str\">\"name\"</span>: <span class=\"str\">\"PetConnect\"</span> } }\r\n      ]\r\n    },\r\n    <span class=\"str\">\"sameAs\"</span>: [\r\n      <span class=\"str\">\"https://www.instagram.com/petsaathi\"</span>,\r\n      <span class=\"str\">\"https://www.facebook.com/petsaathi\"</span>\r\n    ]\r\n  };\r\n\r\n  <span class=\"kw\">return</span> (\r\n    &lt;<span class=\"tag\">script</span>\r\n      <span class=\"attr\">type</span>=<span class=\"val\">\"application/ld+json\"</span>\r\n      <span class=\"attr\">dangerouslySetInnerHTML</span>=<span class=\"val\">{{ __html: JSON.stringify(schema) }}</span>\r\n    /&gt;\r\n  );\r\n}</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── LAZY LOADING ─── -->\r\n  <h2 id=\"lazy-loading\">🐌 AREA 5: Lazy Loading</h2>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-medium\">MEDIUM</span>\r\n      <span class=\"issue-title\">Native Lazy Loading — Add to All Below-Fold Images</span>\r\n      <span class=\"chip chip-perf\">Performance</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">&lt;!-- ❌ No lazy loading — all images load on page open --&gt;</span>\r\n&lt;<span class=\"tag\">img</span> <span class=\"attr\">src</span>=<span class=\"val\">\"service-pet-sitting.jpg\"</span>&gt;\r\n\r\n<span class=\"cm\">&lt;!-- ✅ Lazy load below-fold images --&gt;</span>\r\n&lt;<span class=\"tag\">img</span>\r\n  <span class=\"attr\">src</span>=<span class=\"val\">\"service-pet-sitting.webp\"</span>\r\n  <span class=\"attr\">width</span>=<span class=\"val\">\"400\"</span>\r\n  <span class=\"attr\">height</span>=<span class=\"val\">\"300\"</span>\r\n  <span class=\"attr\">loading</span>=<span class=\"val\">\"lazy\"</span>       <span class=\"cm\">&lt;!-- Browser handles this natively, no JS needed --&gt;</span>\r\n  <span class=\"attr\">decoding</span>=<span class=\"val\">\"async\"</span>    <span class=\"cm\">&lt;!-- Decodes off main thread --&gt;</span>\r\n  <span class=\"attr\">alt</span>=<span class=\"val\">\"PetSaathi partner sitting with dog at home\"</span>\r\n/&gt;\r\n\r\n<span class=\"cm\">/* RULE: Hero image = NO lazy loading (it's LCP)\r\n          All other images = loading=\"lazy\" */</span></code></pre>\r\n  </div>\r\n\r\n  <!-- ─── FONTS ─── -->\r\n  <h2 id=\"fonts\">🔤 AREA 6: Font Loading</h2>\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-medium\">MEDIUM</span>\r\n      <span class=\"issue-title\">Optimize Google Fonts Loading</span>\r\n      <span class=\"chip chip-perf\">Performance</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">&lt;!-- ❌ Render-blocking font import --&gt;</span>\r\n&lt;<span class=\"tag\">link</span> <span class=\"attr\">href</span>=<span class=\"val\">\"https://fonts.googleapis.com/css2?family=Inter\"</span> <span class=\"attr\">rel</span>=<span class=\"val\">\"stylesheet\"</span>&gt;\r\n\r\n<span class=\"cm\">&lt;!-- ✅ Preconnect + non-blocking load --&gt;</span>\r\n&lt;<span class=\"tag\">link</span> <span class=\"attr\">rel</span>=<span class=\"val\">\"preconnect\"</span> <span class=\"attr\">href</span>=<span class=\"val\">\"https://fonts.googleapis.com\"</span>&gt;\r\n&lt;<span class=\"tag\">link</span> <span class=\"attr\">rel</span>=<span class=\"val\">\"preconnect\"</span> <span class=\"attr\">href</span>=<span class=\"val\">\"https://fonts.gstatic.com\"</span> <span class=\"attr\">crossorigin</span>&gt;\r\n&lt;<span class=\"tag\">link</span>\r\n  <span class=\"attr\">rel</span>=<span class=\"val\">\"stylesheet\"</span>\r\n  <span class=\"attr\">href</span>=<span class=\"val\">\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap\"</span>\r\n  <span class=\"attr\">media</span>=<span class=\"val\">\"print\"</span>\r\n  <span class=\"attr\">onload</span>=<span class=\"val\">\"this.media='all'\"</span>\r\n&gt;\r\n\r\n<span class=\"cm\">/* Next.js — use built-in font optimization (zero layout shift) */</span>\r\n<span class=\"kw\">import</span> { Inter } <span class=\"kw\">from</span> <span class=\"str\">'next/font/google'</span>;\r\n\r\n<span class=\"kw\">const</span> inter = <span class=\"fn\">Inter</span>({\r\n  subsets: [<span class=\"str\">'latin'</span>],\r\n  display: <span class=\"str\">'swap'</span>,   <span class=\"cm\">// show system font first, swap to Inter when ready</span>\r\n  weight: [<span class=\"str\">'400'</span>, <span class=\"str\">'600'</span>, <span class=\"str\">'700'</span>],\r\n  preload: <span class=\"kw\">true</span>,\r\n});</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── CLS ─── -->\r\n  <h2 id=\"cls-fix\">📐 AREA 7: CLS Fix — Stop Layout Shifts</h2>\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-high\">HIGH</span>\r\n      <span class=\"issue-title\">Reserve Space for All Dynamic Content</span>\r\n      <span class=\"chip chip-perf\">Performance</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">/* ─── CSS Skeleton Loaders (prevents CLS on dynamic content) ─── */</span>\r\n\r\n.skeleton {\r\n  background: linear-gradient(90deg, #1f2937 25%, #374151 50%, #1f2937 75%);\r\n  background-size: 200% 100%;\r\n  animation: shimmer 1.5s infinite;\r\n  border-radius: 8px;\r\n}\r\n\r\n@keyframes shimmer {\r\n  0% { background-position: 200% 0; }\r\n  100% { background-position: -200% 0; }\r\n}\r\n\r\n<span class=\"cm\">/* Reserve exact space for partner card images */</span>\r\n.partner-card img {\r\n  aspect-ratio: 4 / 3;\r\n  width: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n<span class=\"cm\">/* Reserve space for hero */</span>\r\n.hero-section {\r\n  min-height: 500px;  <span class=\"cm\">/* prevents hero collapse before image loads */</span>\r\n  display: flex;\r\n  align-items: center;\r\n}</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── JS DEFER ─── -->\r\n  <h2 id=\"js-defer\">⏳ AREA 8: JS Deferring & Bundle Splitting</h2>\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-high\">HIGH</span>\r\n      <span class=\"issue-title\">Defer Non-Critical Scripts</span>\r\n      <span class=\"chip chip-code\">Code</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">&lt;!-- ❌ Blocks parsing --&gt;</span>\r\n&lt;<span class=\"tag\">script</span> <span class=\"attr\">src</span>=<span class=\"val\">\"analytics.js\"</span>&gt;&lt;/<span class=\"tag\">script</span>&gt;\r\n\r\n<span class=\"cm\">&lt;!-- ✅ Defer analytics + third-party scripts --&gt;</span>\r\n&lt;<span class=\"tag\">script</span> <span class=\"attr\">src</span>=<span class=\"val\">\"analytics.js\"</span> <span class=\"attr\">defer</span>&gt;&lt;/<span class=\"tag\">script</span>&gt;\r\n\r\n<span class=\"cm\">// Next.js Script component — load analytics after page is interactive</span>\r\n<span class=\"kw\">import</span> Script <span class=\"kw\">from</span> <span class=\"str\">'next/script'</span>;\r\n\r\n&lt;<span class=\"tag\">Script</span>\r\n  <span class=\"attr\">src</span>=<span class=\"val\">\"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXX\"</span>\r\n  <span class=\"attr\">strategy</span>=<span class=\"val\">\"afterInteractive\"</span>   <span class=\"cm\">// ← loads after page is interactive</span>\r\n/&gt;\r\n\r\n<span class=\"cm\">// Dynamic import for heavy components (map, chat widget, etc.)</span>\r\n<span class=\"kw\">import</span> dynamic <span class=\"kw\">from</span> <span class=\"str\">'next/dynamic'</span>;\r\n\r\n<span class=\"kw\">const</span> MapComponent = <span class=\"fn\">dynamic</span>(() =&gt; <span class=\"kw\">import</span>(<span class=\"str\">'./MapComponent'</span>), {\r\n  loading: () =&gt; &lt;<span class=\"tag\">div</span> <span class=\"attr\">className</span>=<span class=\"val\">\"skeleton\"</span> style=<span class=\"val\">{{height:'300px'}}</span> /&gt;,\r\n  ssr: <span class=\"kw\">false</span>,  <span class=\"cm\">// don't SSR map (reduces server payload)</span>\r\n});</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── NEXT.JS TIPS ─── -->\r\n  <h2 id=\"nextjs-tips\">🔧 AREA 9: Vercel/Next.js Specific Wins</h2>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-medium\">MEDIUM</span>\r\n      <span class=\"issue-title\">Add Vercel Analytics + Speed Insights</span>\r\n      <span class=\"chip chip-perf\">Performance</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\"># Install Vercel's official analytics packages</span>\r\nnpm install @vercel/analytics @vercel/speed-insights\r\n\r\n<span class=\"cm\">// app/layout.js (App Router)</span>\r\n<span class=\"kw\">import</span> { Analytics } <span class=\"kw\">from</span> <span class=\"str\">'@vercel/analytics/react'</span>;\r\n<span class=\"kw\">import</span> { SpeedInsights } <span class=\"kw\">from</span> <span class=\"str\">'@vercel/speed-insights/next'</span>;\r\n\r\n<span class=\"kw\">export default function</span> <span class=\"fn\">RootLayout</span>({ children }) {\r\n  <span class=\"kw\">return</span> (\r\n    &lt;<span class=\"tag\">html</span>&gt;\r\n      &lt;<span class=\"tag\">body</span>&gt;\r\n        {children}\r\n        &lt;<span class=\"tag\">Analytics</span> /&gt;         <span class=\"cm\">// track page views & events</span>\r\n        &lt;<span class=\"tag\">SpeedInsights</span> /&gt;    <span class=\"cm\">// real user CWV data in Vercel dashboard</span>\r\n      &lt;/<span class=\"tag\">body</span>&gt;\r\n    &lt;/<span class=\"tag\">html</span>&gt;\r\n  );\r\n}</code></pre>\r\n  </div>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-medium\">MEDIUM</span>\r\n      <span class=\"issue-title\">ISR for Service & Blog Pages</span>\r\n      <span class=\"chip chip-code\">Code</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">// app/services/[slug]/page.js</span>\r\n<span class=\"kw\">export const</span> revalidate = <span class=\"num\">3600</span>; <span class=\"cm\">// rebuild every 1 hour (ISR)</span>\r\n\r\n<span class=\"kw\">export async function</span> <span class=\"fn\">generateStaticParams</span>() {\r\n  <span class=\"kw\">const</span> services = [<span class=\"str\">'pet-sitting'</span>, <span class=\"str\">'dog-walking'</span>, <span class=\"str\">'petconnect'</span>, <span class=\"str\">'events'</span>, <span class=\"str\">'souvenirs'</span>];\r\n  <span class=\"kw\">return</span> services.map(slug =&gt; ({ slug }));\r\n}\r\n\r\n<span class=\"kw\">export default async function</span> <span class=\"fn\">ServicePage</span>({ params }) {\r\n  <span class=\"kw\">const</span> service = <span class=\"kw\">await</span> <span class=\"fn\">fetchService</span>(params.slug);\r\n  <span class=\"kw\">return</span> &lt;<span class=\"tag\">ServiceDetail</span> service={service} /&gt;;\r\n}</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── MOBILE UX ─── -->\r\n  <h2 id=\"ux-mobile\">📱 AREA 10: Mobile UX (India-Specific)</h2>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-high\">HIGH</span>\r\n      <span class=\"issue-title\">WhatsApp Floating Button — Critical for India</span>\r\n      <span class=\"chip chip-ux\">UX</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">// components/WhatsAppButton.jsx</span>\r\n<span class=\"kw\">export default function</span> <span class=\"fn\">WhatsAppButton</span>() {\r\n  <span class=\"kw\">const</span> message = <span class=\"fn\">encodeURIComponent</span>(<span class=\"str\">'Hi PetSaathi! I want to book a pet care service.'</span>);\r\n  <span class=\"kw\">const</span> phone = <span class=\"str\">'91XXXXXXXXXX'</span>; <span class=\"cm\">// replace with real number</span>\r\n\r\n  <span class=\"kw\">return</span> (\r\n    &lt;<span class=\"tag\">a</span>\r\n      <span class=\"attr\">href</span>={`https://wa.me/${phone}?text=${message}`}\r\n      <span class=\"attr\">target</span>=<span class=\"val\">\"_blank\"</span>\r\n      <span class=\"attr\">rel</span>=<span class=\"val\">\"noopener noreferrer\"</span>\r\n      <span class=\"attr\">aria-label</span>=<span class=\"val\">\"Chat with PetSaathi on WhatsApp\"</span>\r\n      <span class=\"attr\">style</span>=<span class=\"val\">{{\r\n        position: 'fixed', bottom: '24px', right: '24px',\r\n        width: '56px', height: '56px', borderRadius: '50%',\r\n        background: '#25D366', display: 'flex',\r\n        alignItems: 'center', justifyContent: 'center',\r\n        boxShadow: '0 4px 20px rgba(37,211,102,.4)',\r\n        zIndex: 9999, textDecoration: 'none',\r\n        transition: 'transform .2s'\r\n      }}</span>\r\n      <span class=\"attr\">onMouseEnter</span>={e =&gt; e.currentTarget.style.transform = <span class=\"str\">'scale(1.1)'</span>}\r\n      <span class=\"attr\">onMouseLeave</span>={e =&gt; e.currentTarget.style.transform = <span class=\"str\">'scale(1)'</span>}\r\n    &gt;\r\n      <span class=\"cm\">/* WhatsApp SVG icon */</span>\r\n      &lt;<span class=\"tag\">svg</span> <span class=\"attr\">width</span>=<span class=\"val\">\"28\"</span> <span class=\"attr\">height</span>=<span class=\"val\">\"28\"</span> <span class=\"attr\">fill</span>=<span class=\"val\">\"white\"</span> <span class=\"attr\">viewBox</span>=<span class=\"val\">\"0 0 24 24\"</span>&gt;\r\n        &lt;<span class=\"tag\">path</span> <span class=\"attr\">d</span>=<span class=\"val\">\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z\"/>\r\n        &lt;<span class=\"tag\">path</span> <span class=\"attr\">d</span>=<span class=\"val\">\"M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.115 1.524 5.843L0 24l6.347-1.501A11.934 11.934 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.797 9.797 0 01-5.031-1.387l-.361-.214-3.737.883.939-3.648-.236-.374A9.794 9.794 0 012.182 12C2.182 6.578 6.578 2.182 12 2.182c5.423 0 9.818 4.396 9.818 9.818 0 5.423-4.395 9.818-9.818 9.818z\"/&gt;\r\n      &lt;/<span class=\"tag\">svg</span>&gt;\r\n    &lt;/<span class=\"tag\">a</span>&gt;\r\n  );\r\n}</code></pre>\r\n  </div>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-medium\">MEDIUM</span>\r\n      <span class=\"issue-title\">Sticky Mobile \"Book Now\" CTA</span>\r\n      <span class=\"chip chip-ux\">UX</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">/* Sticky bottom bar — mobile only */</span>\r\n@media (max-width: 768px) {\r\n  .sticky-cta {\r\n    position: fixed;\r\n    bottom: 0;\r\n    left: 0;\r\n    right: 0;\r\n    padding: 12px 16px;\r\n    background: #fff;\r\n    border-top: 1px solid #e5e7eb;\r\n    box-shadow: 0 -4px 20px rgba(0,0,0,.08);\r\n    display: flex;\r\n    gap: 10px;\r\n    z-index: 100;\r\n  }\r\n\r\n  .sticky-cta .btn-book {\r\n    flex: 1;\r\n    background: #f97316;   <span class=\"cm\">/* PetSaathi brand orange */</span>\r\n    color: #fff;\r\n    border: none;\r\n    border-radius: 10px;\r\n    padding: 14px;\r\n    font-size: 16px;\r\n    font-weight: 700;\r\n    min-height: 48px;      <span class=\"cm\">/* 48px tap target */</span>\r\n    cursor: pointer;\r\n  }\r\n\r\n  .sticky-cta .btn-wa {\r\n    width: 48px;\r\n    height: 48px;\r\n    background: #25D366;\r\n    border: none;\r\n    border-radius: 10px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    cursor: pointer;\r\n  }\r\n}</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── CTA ─── -->\r\n  <h2 id=\"cta\">🎯 AREA 11: CTA Improvements</h2>\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-medium\">MEDIUM</span>\r\n      <span class=\"issue-title\">Replace \"Join Waitlist\" with Urgency-Driven CTAs</span>\r\n      <span class=\"chip chip-ux\">UX</span>\r\n    </div>\r\n    <div class=\"callout callout-tip\">\r\n      <div class=\"callout-icon\">💡</div>\r\n      <div class=\"callout-body\"><strong>\"Join Waitlist\"</strong> signals the app is not ready. Even if you are in beta, frame it differently to build excitement and reduce drop-off.</div>\r\n    </div>\r\n    <pre><code><span class=\"cm\">/* ❌ Low-converting CTAs */</span>\r\n\"Join Waitlist\"    →  feels inactive, not launched\r\n\"Become a Partner\" →  vague\r\n\r\n<span class=\"cm\">/* ✅ Higher-converting alternatives */</span>\r\n\"Book Your First Walk →\"\r\n\"Get Early Access + ₹200 Welcome Credit\"\r\n\"Find a Sitter Near Me\"\r\n\"I Want a Partner for My Pet\"  <span class=\"cm\">// emotional, India-specific voice</span>\r\n\r\n<span class=\"cm\">// Urgency example with city counter</span>\r\n&lt;<span class=\"tag\">button</span> <span class=\"attr\">className</span>=<span class=\"val\">\"btn-primary\"</span>&gt;\r\n  Book My Pet's First Walk\r\n  &lt;<span class=\"tag\">span</span> <span class=\"attr\">className</span>=<span class=\"val\">\"badge-new\"</span>&gt;Free first session&lt;/<span class=\"tag\">span</span>&gt;\r\n&lt;/<span class=\"tag\">button</span>&gt;</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── TRUST ─── -->\r\n  <h2 id=\"trust\">🏅 AREA 12: Trust Signals</h2>\r\n\r\n  <div class=\"issue\">\r\n    <div class=\"issue-header\">\r\n      <span class=\"badge badge-medium\">MEDIUM</span>\r\n      <span class=\"issue-title\">Stats Bar + Testimonials Component</span>\r\n      <span class=\"chip chip-ux\">UX</span>\r\n    </div>\r\n    <pre><code><span class=\"cm\">// components/StatsBar.jsx</span>\r\n<span class=\"kw\">const</span> stats = [\r\n  { number: <span class=\"str\">'100+'</span>, label: <span class=\"str\">'Verified Partners'</span>, icon: <span class=\"str\">'✅'</span> },\r\n  { number: <span class=\"str\">'4.9★'</span>, label: <span class=\"str\">'Avg. Rating'</span>,        icon: <span class=\"str\">'⭐'</span> },\r\n  { number: <span class=\"str\">'500+'</span>, label: <span class=\"str\">'Happy Pets Served'</span>,  icon: <span class=\"str\">'🐶'</span> },\r\n  { number: <span class=\"str\">'3'</span>,    label: <span class=\"str\">'Cities Live'</span>,        icon: <span class=\"str\">'📍'</span> },\r\n];\r\n\r\n<span class=\"kw\">// components/Testimonials.jsx</span>\r\n<span class=\"kw\">const</span> reviews = [\r\n  {\r\n    name: <span class=\"str\">\"Priya S.\"</span>, city: <span class=\"str\">\"Mumbai\"</span>, pet: <span class=\"str\">\"Labrador\"</span>, stars: <span class=\"num\">5</span>,\r\n    text: <span class=\"str\">\"Rocky used to get so anxious when I left. With PetSaathi, I get live photos every 20 mins. Absolute peace of mind!\"</span>\r\n  },\r\n  {\r\n    name: <span class=\"str\">\"Arjun M.\"</span>, city: <span class=\"str\">\"Bangalore\"</span>, pet: <span class=\"str\">\"Beagle\"</span>, stars: <span class=\"num\">5</span>,\r\n    text: <span class=\"str\">\"Affordable, verified, and genuinely loving partners. My dog refuses to come home after walks now 😂\"</span>\r\n  },\r\n  {\r\n    name: <span class=\"str\">\"Sneha K.\"</span>, city: <span class=\"str\">\"Pune\"</span>, pet: <span class=\"str\">\"Persian Cat\"</span>, stars: <span class=\"num\">5</span>,\r\n    text: <span class=\"str\">\"First-ever cat sitting service that actually understood cats. Mitti was so calm when I came back!\"</span>\r\n  },\r\n];</code></pre>\r\n  </div>\r\n\r\n  <!-- ─── FINAL CHECKLIST ─── -->\r\n  <h2 id=\"final-checklist\">✅ Priority Checklist — Do This in Order</h2>\r\n  <p>Work through these <strong>top to bottom</strong>. Items 1–5 are <strong>today</strong>. Items 6–15 are <strong>this week</strong>.</p>\r\n\r\n  <ul class=\"checklist\">\r\n    <li><strong>[TODAY]</strong> Remove all lorem ipsum / gibberish placeholder text from FAQ section</li>\r\n    <li><strong>[TODAY]</strong> Replace fake phone number \"656456456\" with real/WhatsApp contact</li>\r\n    <li><strong>[TODAY]</strong> Fill all empty FAQ entries with real India-specific pet care content</li>\r\n    <li><strong>[TODAY]</strong> Add complete meta description, og:title, og:image to &lt;head&gt;</li>\r\n    <li><strong>[TODAY]</strong> Add canonical URL and robots meta tag</li>\r\n    <li><strong>[WEEK 1]</strong> Add <code>priority</code> prop to hero &lt;Image&gt; (LCP fix)</li>\r\n    <li><strong>[WEEK 1]</strong> Add <code>width</code> and <code>height</code> to every &lt;img&gt; tag (CLS fix)</li>\r\n    <li><strong>[WEEK 1]</strong> Add <code>loading=\"lazy\"</code> to all below-fold images</li>\r\n    <li><strong>[WEEK 1]</strong> Move images from qubetatechnolab.com to /public + use Vercel Image</li>\r\n    <li><strong>[WEEK 1]</strong> Defer all analytics / third-party scripts with <code>strategy=\"afterInteractive\"</code></li>\r\n    <li><strong>[WEEK 1]</strong> Add WhatsApp floating button</li>\r\n    <li><strong>[WEEK 1]</strong> Add JSON-LD LocalBusiness structured data</li>\r\n    <li><strong>[WEEK 2]</strong> Convert all images to WebP</li>\r\n    <li><strong>[WEEK 2]</strong> Add testimonials/reviews section</li>\r\n    <li><strong>[WEEK 2]</strong> Add stats bar (partners count, rating, pets served)</li>\r\n    <li><strong>[WEEK 2]</strong> Add Vercel Analytics + SpeedInsights</li>\r\n    <li><strong>[WEEK 2]</strong> Enable ISR on service/blog pages</li>\r\n    <li><strong>[WEEK 3]</strong> Add sitemap.xml and robots.txt</li>\r\n    <li><strong>[WEEK 3]</strong> Enable next/font for zero-CLS font loading</li>\r\n    <li><strong>[WEEK 3]</strong> Add dynamic import() for map / heavy components</li>\r\n  </ul>\r\n\r\n  <!-- ─── Q&A ─── -->\r\n  <h2 id=\"qa\">❓ Q&A Deep Dives</h2>\r\n\r\n  <details>\r\n    <summary>🤔 Why is mobile score lower than desktop?</summary>\r\n    <div class=\"qa-body\">\r\n      <p>Mobile PageSpeed is harder because: (1) CPU throttled to 4x slower than desktop, (2) bandwidth simulated at ~1.6 Mbps 3G, (3) viewport is narrow so images/fonts must be mobile-optimized. India's user base is predominantly mobile (85%+ on Android), so fixing mobile score is your highest priority.</p>\r\n      <p>The biggest mobile killers for PetSaathi are: large unoptimized images, external image CDN (qubetatechnolab.com), and render-blocking resources.</p>\r\n    </div>\r\n  </details>\r\n\r\n  <details>\r\n    <summary>🤔 What is LCP and how do I fix it specifically?</summary>\r\n    <div class=\"qa-body\">\r\n      <p><strong>LCP = Largest Contentful Paint</strong> — the time until the biggest visible element is rendered. For PetSaathi it's almost certainly the hero image or hero headline.</p>\r\n      <p><strong>Target: under 2.5s on mobile.</strong></p>\r\n      <p>Fix it in 3 steps:</p>\r\n      <ol class=\"steps\">\r\n        <li>Put the hero image in your own <code>/public</code> folder (not qubetatechnolab.com)</li>\r\n        <li>Add <code>priority</code> prop to the Next.js &lt;Image&gt; (this generates a &lt;link rel=\"preload\"&gt;)</li>\r\n        <li>Convert the hero to WebP and serve at the right size (max 800px wide for mobile)</li>\r\n      </ol>\r\n    </div>\r\n  </details>\r\n\r\n  <details>\r\n    <summary>🤔 What is CLS and why does it hurt my score?</summary>\r\n    <div class=\"qa-body\">\r\n      <p><strong>CLS = Cumulative Layout Shift</strong> — measures how much content jumps around as the page loads. Users hate it. Google penalizes it.</p>\r\n      <p>On PetSaathi, CLS is caused by images loading without explicit dimensions — the browser doesn't know how tall the image will be, so it reserves no space, then shifts everything down when the image appears.</p>\r\n      <p><strong>Fix:</strong> Add <code>width</code> and <code>height</code> attributes to every single image. One-line fix, huge score improvement.</p>\r\n      <pre><code>&lt;<span class=\"tag\">img</span> <span class=\"attr\">src</span>=<span class=\"val\">\"dog.webp\"</span> <span class=\"attr\">width</span>=<span class=\"val\">\"400\"</span> <span class=\"attr\">height</span>=<span class=\"val\">\"300\"</span> <span class=\"attr\">alt</span>=<span class=\"val\">\"...\"</span>&gt;</code></pre>\r\n    </div>\r\n  </details>\r\n\r\n  <details>\r\n    <summary>🤔 How do I check my actual PageSpeed score after fixing?</summary>\r\n    <div class=\"qa-body\">\r\n      <p>Run: <a href=\"https://pagespeed.web.dev\" style=\"color:var(--blue)\">pagespeed.web.dev</a> — paste your URL and select Mobile tab.</p>\r\n      <p>Also run locally using Lighthouse in Chrome DevTools → Lighthouse tab → Mobile → Analyze. This gives you line-by-line breakdowns without waiting for the public report.</p>\r\n      <p>After each batch of fixes, re-run the report and compare. Target: <strong>Performance &gt; 70</strong> on mobile.</p>\r\n    </div>\r\n  </details>\r\n\r\n  <details>\r\n    <summary>🤔 Should I move off qubetatechnolab.com for hosting images?</summary>\r\n    <div class=\"qa-body\">\r\n      <p><strong>Yes, as soon as possible.</strong> When images come from a third-party domain, users' browsers must:</p>\r\n      <ol class=\"steps\">\r\n        <li>Look up qubetatechnolab.com's DNS (extra ~50–200ms on mobile)</li>\r\n        <li>Establish a new HTTPS connection (another ~100ms)</li>\r\n        <li>Download the image (unoptimized, probably JPG/PNG not WebP)</li>\r\n      </ol>\r\n      <p>When you host on Vercel, Next.js's Image Optimization automatically converts to WebP/AVIF, resizes for device, caches on CDN, and serves from the same domain — saving 300–500ms per image on mobile.</p>\r\n    </div>\r\n  </details>\r\n\r\n  <details>\r\n    <summary>🤔 How do I target Indian users specifically in PageSpeed?</summary>\r\n    <div class=\"qa-body\">\r\n      <p>PageSpeed uses US-based servers. Your real Indian users may have different results. To get India-specific data:</p>\r\n      <ol class=\"steps\">\r\n        <li>Use <strong>WebPageTest.org</strong> → set location to \"Bangalore\" or \"Mumbai\", connection to \"4G India\"</li>\r\n        <li>Enable <strong>Vercel Speed Insights</strong> — shows real user CWV data segmented by country/device</li>\r\n        <li>Use <strong>GTmetrix</strong> → select Mumbai server location</li>\r\n      </ol>\r\n      <p>Also: optimize for low-end Android phones (the dominant India device). Simulate in Chrome DevTools → CPU throttle 6x, Network throttle \"Fast 3G\".</p>\r\n    </div>\r\n  </details>\r\n\r\n  <div style=\"margin-top:60px;padding:24px;background:var(--surface);border-radius:12px;border:1px solid var(--border);text-align:center;\">\r\n    <div style=\"font-size:32px;margin-bottom:8px;\">🐾</div>\r\n    <div style=\"font-weight:700;font-size:16px;margin-bottom:6px;\">PetSaathi Super Master Prompt</div>\r\n    <div style=\"color:var(--muted);font-size:13px;\">Generated from PageSpeed Report · September 8, 2026 · petsaathi.blue.vercel.app (Mobile)</div>\r\n    <div style=\"margin-top:12px;font-size:13px;color:var(--muted);\">Copy the Super Master Prompt at the top and paste into Claude with your codebase to fix all 20 items automatically.</div>\r\n  </div>\r\n\r\n</main>\r\n</body>\r\n</html>\n</USER_REQUEST>\n<ADDITIONAL_METADATA>\nThe current local time is: 2026-09-08T12:19:02+05:30.\n</ADDITIONAL_METADATA>\n<USER_SETTINGS_CHANGE>\nThe user changed setting `Model Selection` from Gemini 3.8 Flash (Medium) to Gemini 3.1 Pro (Low). No need to comment on this change if the user doesn't ask about it. If reporting what model you are, please use a human readable name instead of the exact string.\n</USER_SETTINGS_CHANGE>"}
