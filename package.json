    "lucide-react": "^0.544.0",
    "mongodb": "6.21.0",
    "next": "^15.5.0",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "openai": "^7.4.0",
    "rate-limiter-flexible": "^11.2.0",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-cookie-consent": "^10.0.2",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.0.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
