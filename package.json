{
  "name": "petsaathi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:integration:setup": "docker compose -f docker-compose.test.yml up -d --wait && node scripts/init-test-db.js",
    "test:integration:teardown": "docker compose -f docker-compose.test.yml down --volumes --remove-orphans",
    "test:integration:verify-db": "node scripts/verify-test-db.js",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push && npm run mongodb:indexes",
    "prisma:seed": "prisma db seed",
    "seed:rich": "node scripts/seed-rich-demo.mjs",
    "simulate:walk": "npx tsx scripts/simulate-complete-walk.ts",
    "test:simulate": "npx tsx scripts/simulate-complete-walk.ts",
    "test:concurrency": "vitest run tests/concurrency",
    "mongodb:indexes": "node scripts/apply-mongodb-indexes.js",
    "migrate": "npx tsx scripts/db/migrate.ts",
    "doctor": "node scripts/verify-runtime-setup.js",
    "doctor:production": "node scripts/verify-runtime-setup.js --production",
    "doctor:providers": "node scripts/verify-provider-integrations.js",
    "db:migrate-to-atlas": "node scripts/migrate-postgres-to-mongodb.js",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "cap:doctor": "npx cap doctor",
    "cap:add": "npx cap add android",
    "cap:prepare": "node scripts/prepare-capacitor-webdir.mjs",
    "cap:add:android": "npm run cap:prepare && npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
    "cap:open": "npx cap open android",
    "cap:run:android": "npx cap run android",
    "mobile:build": "npm run cap:sync && cd android && gradlew assembleDebug --no-daemon",
    "android:sync:local": "npm run cap:prepare && node scripts/sync-android-local.mjs",
    "ai:test": "node test-router-phase3.mjs",
    "ai:test:analyzer": "node test-analyzer-phase4.mjs",
    "ai:test:classifier": "node test-classifier-phase4b.mjs",
    "ai:benchmark": "npx tsx scripts/ai-benchmark.ts",
    "ai:benchmark:legacy": "node ai/benchmark.mjs",
    "ai:models": "node ai/list-models.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
